local function parentGui(gui)
    local ok = false
    pcall(function()
        if syn and syn.protect_gui then syn.protect_gui(gui); gui.Parent = CoreGui; ok = true end
    end)
    if not ok then pcall(function() if gethui then gui.Parent = gethui(); ok = true end end) end
    if not ok then pcall(function() gui.Parent = CoreGui; ok = true end) end
    if not ok then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

-- Smooth draggable. Uses RenderStepped with optional smoothing toward target.
local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    local targetPos = frame.Position

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            targetPos = frame.Position
            local changed; changed = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    if changed then changed:Disconnect() end
                end
            end)
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging
        and (input.UserInputType == Enum.UserInputType.MouseMovement
          or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            targetPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
            if (Phantom.Config.DragSmoothness or 0) <= 0 then
                frame.Position = targetPos
            end
        end
    end)

    -- Per-frame smoothing if enabled
    RunService.RenderStepped:Connect(function(dt)
        if not dragging then return end
        local s = Phantom.Config.DragSmoothness or 0
        if s <= 0 then return end
        local cur = frame.Position
        local alpha = 1 - math.exp(-dt / s)
        frame.Position = UDim2.new(
            cur.X.Scale + (targetPos.X.Scale - cur.X.Scale) * alpha,
            cur.X.Offset + (targetPos.X.Offset - cur.X.Offset) * alpha,
            cur.Y.Scale + (targetPos.Y.Scale - cur.Y.Scale) * alpha,
            cur.Y.Offset + (targetPos.Y.Offset - cur.Y.Offset) * alpha
        )
    end)
end

local function isMobile()
    return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
end

