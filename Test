function Phantom:InitCrosshair()
    local Config = self.Config
    local Camera = workspace.CurrentCamera
    
    local Crosshair = {
        Lines = {},
        Dot = Drawing.new("Circle")
    }

    -- Inicjalizacja 4 linii
    for i = 1, 4 do
        local Line = Drawing.new("Line")
        Line.Thickness = 1
        Line.Transparency = 1
        Line.Visible = false
        table.insert(Crosshair.Lines, Line)
    end

    -- Inicjalizacja kropki
    Crosshair.Dot.Filled = true
    Crosshair.Dot.Radius = 2
    Crosshair.Dot.Visible = false

    game:GetService("RunService").RenderStepped:Connect(function()
        local Enabled = self.Flags["Crosshair_Enabled"]
        local Center = Camera.ViewportSize / 2
        
        -- Pobieranie parametrów z Flags
        local Size = self.Flags["Crosshair_Size"] or 10
        local Gap = self.Flags["Crosshair_Gap"] or 5
        local Thickness = self.Flags["Crosshair_Thickness"] or 1
        local ShowDot = self.Flags["Crosshair_Dot"]
        local Color = self.Flags["Crosshair_Color"] or Config.Theme.Accent

        Crosshair.Dot.Visible = Enabled and ShowDot
        Crosshair.Dot.Position = Center
        Crosshair.Dot.Color = Color

        for i, Line in pairs(Crosshair.Lines) do
            Line.Visible = Enabled
            Line.Thickness = Thickness
            Line.Color = Color
            
            if i == 1 then -- Góra
                Line.From = Center - Vector2.new(0, Gap)
                Line.To = Center - Vector2.new(0, Gap + Size)
            elseif i == 2 then -- Dół
                Line.From = Center + Vector2.new(0, Gap)
                Line.To = Center + Vector2.new(0, Gap + Size)
            elseif i == 3 then -- Lewo
                Line.From = Center - Vector2.new(Gap, 0)
                Line.To = Center - Vector2.new(Gap + Size, 0)
            elseif i == 4 then -- Prawo
                Line.From = Center + Vector2.new(Gap, 0)
                Line.To = Center + Vector2.new(Gap + Size, 0)
            end
        end
    end)
end
