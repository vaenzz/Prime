function Phantom:CreateChams(TargetPlayer)
    local function Apply(character)
        if not character then return end
        
        -- Usuwamy stary highlight jeśli istnieje
        local existing = character:FindFirstChild("PhantomChams")
        if existing then existing:Destroy() end

        local Highlight = Instance.new("Highlight")
        Highlight.Name = "PhantomChams"
        Highlight.Parent = character
        Highlight.Enabled = self.Flags["ESP_Chams"] or false
        Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- Klucz do widzenia przez ściany
        Highlight.FillColor = self.Flags["Chams_FillColor"] or self.Config.Theme.Accent
        Highlight.OutlineColor = self.Flags["Chams_OutlineColor"] or Color3.fromRGB(255, 255, 255)
        Highlight.FillTransparency = 0.5
        Highlight.OutlineTransparency = 0

        -- Pętla aktualizująca stan
        task.spawn(function()
            while character.Parent and Highlight.Parent do
                Highlight.Enabled = self.Flags["ESP_Chams"] or false
                Highlight.FillColor = self.Flags["Chams_FillColor"] or self.Config.Theme.Accent
                task.wait(0.5) -- Niskie odświeżanie wystarczy dla statycznych kolorów
            end
        end)
    end

    -- Obsługa respawnu
    TargetPlayer.CharacterAdded:Connect(Apply)
    if TargetPlayer.Character then Apply(TargetPlayer.Character) end
end

-- Zainicjuj dla obecnych graczy
for _, v in pairs(game.Players:GetPlayers()) do
    if v ~= game.Players.LocalPlayer then Phantom:CreateChams(v) end
end
