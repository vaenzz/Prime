function Phantom:AddResizeHandle(window)
    local Handle = Instance.new("ImageButton")
    Handle.Name = "ResizeHandle"
    Handle.Parent = window.Main
    Handle.Position = UDim2.new(1, -15, 1, -15)
    Handle.Size = UDim2.new(0, 15, 0, 15)
    Handle.BackgroundTransparency = 1
    Handle.Image = "rbxassetid://6034170308" -- Ikona narożnika
    Handle.ImageColor3 = self.Config.Theme.TextMuted

    local dragging = false
    local startPos, startSize

    Handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            startPos = input.Position
            startSize = window.Main.Size
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - startPos
            window.Main.Size = UDim2.new(0, math.clamp(startSize.X.Offset + delta.X, 400, 800), 0, math.clamp(startSize.Y.Offset + delta.Y, 300, 600))
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
end
