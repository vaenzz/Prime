-- [43] HIT MARKER & SOUND SYSTEM (Feedback trafień - Styl CoD)
--========================================================================

function Phantom:SpawnHitMarker()
    local Camera = workspace.CurrentCamera
    local Center = Camera.ViewportSize / 2
    local Lines = {}
    local Duration = 0.4 -- Jak długo widać hitmarker
    
    for i = 1, 4 do
        local L = Drawing.new("Line")
        L.Thickness = 1.5
        L.Color = Color3.fromRGB(255, 255, 255)
        L.Transparency = 1
        L.Visible = true
        table.insert(Lines, L)
    end

    local Size = 6
    local Gap = 4

    Lines[1].From = Center + Vector2.new(Gap, Gap)
    Lines[1].To = Center + Vector2.new(Gap + Size, Gap + Size)

    Lines[2].From = Center + Vector2.new(-Gap, Gap)
    Lines[2].To = Center + Vector2.new(-Gap - Size, Gap + Size)

    Lines[3].From = Center + Vector2.new(Gap, -Gap)
    Lines[3].To = Center + Vector2.new(Gap + Size, -Gap - Size)

    Lines[4].From = Center + Vector2.new(-Gap, -Gap)
    Lines[4].To = Center + Vector2.new(-Gap - Size, -Gap - Size)

    -- Animacja znikania
    task.spawn(function()
        for i = 1, 10 do
            local trans = 1 - (i/10)
            for _, L in pairs(Lines) do L.Transparency = trans end
            task.wait(Duration/10)
        end
        for _, L in pairs(Lines) do L:Remove() end
    end)
end

function Phantom:InitHitSystem()
    local Players = game:GetService("Players")
    
    local function Monitor(plr)
        if plr == Players.LocalPlayer then return end
        plr.CharacterAdded:Connect(function(char)
            local hum = char:WaitForChild("Humanoid")
            local lastHealth = hum.Health
            
            hum.HealthChanged:Connect(function(health)
                if health < lastHealth and self.Flags["HitMarker_Enabled"] then
                    self:SpawnHitMarker()
                    if self.Flags["HitSound_Enabled"] then
                        self:PlaySound("Notify") -- Lub dedykowany hit-sound
                    end
                end
                lastHealth = health
            end)
        end)
    end

    for _, v in pairs(Players:GetPlayers()) do Monitor(v) end
    Players.PlayerAdded:Connect(Monitor)
end
