    SBLine.BackgroundColor3 = Config.Theme.Outline
    SBLine.BackgroundTransparency = 0.5
    SBLine.BorderSizePixel = 0

    local StatHolder = Instance.new("Frame")
    StatHolder.Parent = StatusBar
    StatHolder.Size = UDim2.new(1, -20, 1, 0)
    StatHolder.Position = UDim2.new(0, 10, 0, 0)
    StatHolder.BackgroundTransparency = 1

    local StatList = Instance.new("UIListLayout")
    StatList.Parent = StatHolder
    StatList.FillDirection = Enum.FillDirection.Horizontal
    StatList.VerticalAlignment = Enum.VerticalAlignment.Center
    StatList.Padding = UDim.new(0, 15)

    local function CreateStat(name, icon)
        local Label = Instance.new("TextLabel")
        Label.Name = name
        Label.Parent = StatHolder
        Label.AutomaticSize = Enum.AutomaticSize.X
        Label.Size = UDim2.new(0, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.Font = Enum.Font.GothamMedium
        Label.TextColor3 = Config.Theme.TextMuted
        Label.TextSize = 10
        Label.Text = icon .. " " .. name .. ": --"
        return Label
    end

    local FPSLabel = CreateStat("FPS", "⚡")
    local PingLabel = CreateStat("PING", "📡")
    local MemLabel = CreateStat("MEM", "💾")

    -- Silnik Monitoringu
    local LastIteration = tick()
    local FrameLog = {}

    game:GetService("RunService").RenderStepped:Connect(function()
        local CurrentTime = tick()
        local DeltaTime = CurrentTime - LastIteration
        LastIteration = CurrentTime
        
        -- FPS Logic
        table.insert(FrameLog, DeltaTime)
        if #FrameLog > 60 then table.remove(FrameLog, 1) end
        
        local AvgDelta = 0
        for _, v in pairs(FrameLog) do AvgDelta = AvgDelta + v end
        local FPS = math.floor(1 / (AvgDelta / #FrameLog))
        
        -- Update Labels
        FPSLabel.Text = "⚡ FPS: " .. FPS
        
        -- Ping Logic (Approximate)
        local Ping = math.floor(game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue())
        PingLabel.Text = "📡 PING: " .. Ping .. "ms"
        
        -- Memory Logic
        local Mem = math.floor(game:GetService("Stats"):GetTotalMemoryUsageMb())
        MemLabel.Text = "💾 MEM: " .. Mem .. "MB"
        
        -- Kolorowanie dynamiczne (Warning colors)
        FPSLabel.TextColor3 = FPS < 30 and Color3.fromRGB(255, 100, 100) or Config.Theme.TextMuted
        PingLabel.TextColor3 = Ping > 150 and Color3.fromRGB(255, 150, 50) or Config.Theme.TextMuted
    end)
end
