        Utils:Tween(TText, {TextColor3 = Config.Theme.Text}, 0.2)
        Utils:Tween(TabButton, {BackgroundTransparency = 0.8}, 0.2)
    end

    TabButton.MouseButton1Click:Connect(Activate)

    -- Jeśli to pierwszy tab, aktywuj go od razu
    if #window.Tabs == 0 then Activate() end

    Tab.Page = Page
    Tab.Button = TabButton
    table.insert(window.Tabs, Tab)

