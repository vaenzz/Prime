    local PagePadding = Instance.new("UIPadding")
    PagePadding.Parent = Page
    PagePadding.PaddingLeft = UDim.new(0, 20)
    PagePadding.PaddingRight = UDim.new(0, 20)
    PagePadding.PaddingTop = UDim.new(0, 50) -- Miejsce na Search Bar w przyszłości

    -- Funkcja Aktywacji
    function Tab:Activate()
        for _, t in pairs(Window.Tabs) do
            t.Page.Visible = false
            Utils:Tween(t.Btn, {BackgroundTransparency = 1}, 0.2)
            Utils:Tween(t.Label, {TextColor3 = Config.Theme.TextMuted}, 0.2)
            Utils:Tween(t.Bar, {BackgroundTransparency = 1, Position = UDim2.new(0, -10, 0.5, -8)}, 0.2)
        end
        
        Page.Visible = true
        Page.GroupTransparency = 1
        Utils:Tween(Page, {GroupTransparency = 0}, 0.3) -- Fade-in effect
        
        Utils:Tween(TabBtn, {BackgroundTransparency = 0.9}, 0.2)
