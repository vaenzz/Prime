--[[
    Phantom UI Library
    Pure black + electric blue aesthetic. Rayfield-compatible API.

    Usage:
        local Phantom = loadstring(game:HttpGet("YOUR_URL"))()
        local Window = Phantom:CreateWindow({
            Name = "My Hub",
            LoadingSubtitle = "by you",
            ConfigurationSaving = { Enabled = true, FileName = "MyHub" },
            KeySystem = false,
        })
        local Tab = Window:CreateTab("Main")
        Tab:CreateToggle({ Name = "Auto Farm", CurrentValue = false, Callback = function(v) end })
]]

local Phantom = {}
Phantom.Flags = {}
Phantom._connections = {}

local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local HttpService = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer

-- Theme: pure black + electric blue --------------------------------------
local Theme = {
    Bg            = Color3.fromRGB(8, 8, 10),
    BgSoft        = Color3.fromRGB(14, 14, 18),
    Panel         = Color3.fromRGB(18, 18, 24),
    PanelSoft     = Color3.fromRGB(22, 22, 28),
    Element       = Color3.fromRGB(24, 26, 34),
    ElementHover  = Color3.fromRGB(32, 36, 48),
    ElementActive = Color3.fromRGB(40, 46, 62),

    Accent        = Color3.fromRGB(0, 162, 255),
    AccentBright  = Color3.fromRGB(64, 196, 255),
    AccentDim     = Color3.fromRGB(0, 110, 200),
    AccentGlow    = Color3.fromRGB(0, 200, 255),

    Text          = Color3.fromRGB(245, 248, 255),
    TextDim       = Color3.fromRGB(165, 175, 195),
    TextDark      = Color3.fromRGB(95, 105, 125),

    Stroke        = Color3.fromRGB(34, 38, 52),
    StrokeStrong  = Color3.fromRGB(55, 62, 82),
    StrokeAccent  = Color3.fromRGB(0, 130, 220),
}

-- Animation presets ------------------------------------------------------
local Anim = {
    Fast    = TweenInfo.new(0.18, Enum.EasingStyle.Quad,  Enum.EasingDirection.Out),
    Smooth  = TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
    Spring  = TweenInfo.new(0.45, Enum.EasingStyle.Back,  Enum.EasingDirection.Out),
    Slow    = TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out),
}

-- Helpers ----------------------------------------------------------------
local function new(class, props, children)
    local inst = Instance.new(class)
    for k, v in pairs(props or {}) do inst[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = inst end
    return inst
end

local function tween(obj, info, props)
    local t = TweenService:Create(obj, info or Anim.Smooth, props)
    t:Play()
    return t
end

local function corner(parent, r)
    new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
    return parent
end

local function stroke(parent, color, thickness, transparency)
    return new("UIStroke", {
        Color = color or Theme.Stroke,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function gradient(parent, colors, rotation)
    return new("UIGradient", {
        Color = ColorSequence.new(colors),
        Rotation = rotation or 0,
        Parent = parent,
    })
end

local function padding(parent, t, b, l, r)
    new("UIPadding", {
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        Parent = parent,
    })
end

local function listLayout(parent, padPx, dir)
    return new("UIListLayout", {
        FillDirection = dir or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, padPx or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

-- Soft circular glow using a 9-slice image
local function glow(parent, color, intensity)
    return new("ImageLabel", {
        BackgroundTransparency = 1,
        Image = "rbxassetid://5028857084",
        ImageColor3 = color or Theme.Accent,
        ImageTransparency = intensity or 0.5,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(24, 24, 276, 276),
        Size = UDim2.new(1, 30, 1, 30),
        Position = UDim2.new(0, -15, 0, -15),
        ZIndex = (parent.ZIndex or 1) - 1,
        Parent = parent,
    })
end

local function parentGui(gui)
    local ok = pcall(function()
        if syn and syn.protect_gui then
            syn.protect_gui(gui); gui.Parent = CoreGui
        elseif gethui then
            gui.Parent = gethui()
        else
            gui.Parent = CoreGui
        end
    end)
    if not ok then gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
end

local function track(conn) table.insert(Phantom._connections, conn); return conn end

local function makeDraggable(frame, handle)
    local dragging, dragStart, startPos = false, nil, nil
    track(handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; dragStart = input.Position; startPos = frame.Position
            local conn; conn = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false; conn:Disconnect()
                end
            end)
        end
    end))
    track(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end))
end

-- Configuration save/load ------------------------------------------------
local CFG_FOLDER = "Phantom"
local CFG_EXT = ".pcfg"

local function fsAvailable()
    return writefile and readfile and isfile and isfolder and makefolder
end

local function ensureFolder(path)
    if fsAvailable() and not isfolder(path) then pcall(makefolder, path) end
end

-- Notifications ----------------------------------------------------------
local NotifGui

local function ensureNotifGui()
    if NotifGui and NotifGui.Parent then return end
    NotifGui = new("ScreenGui", {
        Name = "PhantomNotifs", IgnoreGuiInset = true,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 999,
    })
    parentGui(NotifGui)
    local list = new("Frame", {
        Name = "List", BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -24, 1, -24),
        Size = UDim2.new(0, 340, 1, -48),
        Parent = NotifGui,
    })
    new("UIListLayout", {
        VerticalAlignment = Enum.VerticalAlignment.Bottom,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        Padding = UDim.new(0, 10),
        Parent = list,
    })
end

function Phantom:Notify(data)
    ensureNotifGui()
    local notif = new("Frame", {
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = NotifGui.List,
    })
    corner(notif, 10)
    local nstroke = stroke(notif, Theme.StrokeAccent, 1, 1)
    padding(notif, 14, 14, 16, 16)
    glow(notif, Theme.Accent, 0.85)

    local accent = new("Frame", {
        BackgroundColor3 = Theme.Accent,
        Position = UDim2.new(0, -16, 0, -14),
        Size = UDim2.new(0, 3, 1, 28),
        Parent = notif,
    })
    gradient(accent, { ColorSequenceKeypoint.new(0, Theme.AccentBright), ColorSequenceKeypoint.new(1, Theme.Accent) }, 90)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.Text, TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = data.Title or "Notification",
        Parent = notif,
    })
    local content = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 22),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.TextDim, TextTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
        Text = data.Content or "",
        Parent = notif,
    })

    notif.Position = UDim2.new(1, 50, 0, 0)
    tween(notif, Anim.Spring, { BackgroundTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
    tween(nstroke, Anim.Smooth, { Transparency = 0 })
    tween(title, Anim.Smooth, { TextTransparency = 0 })
    tween(content, Anim.Smooth, { TextTransparency = 0.15 })

    task.delay(data.Duration or 4, function()
        tween(notif, Anim.Smooth, { BackgroundTransparency = 1, Position = UDim2.new(1, 50, 0, 0) })
        tween(nstroke, Anim.Fast, { Transparency = 1 })
        tween(title, Anim.Fast, { TextTransparency = 1 })
        tween(content, Anim.Fast, { TextTransparency = 1 })
        task.wait(0.4); notif:Destroy()
    end)
end

-- Window -----------------------------------------------------------------
function Phantom:CreateWindow(settings)
    settings = settings or {}

    -- Key system ---------------------------------------------------------
    if settings.KeySystem and settings.KeySettings then
        local keys = settings.KeySettings.Key
        if type(keys) == "string" then keys = { keys } end

        local KeyGui = new("ScreenGui", {
            Name = "PhantomKey", IgnoreGuiInset = true,
            ResetOnSpawn = false, DisplayOrder = 200,
        })
        parentGui(KeyGui)

        local backdrop = new("Frame", {
            BackgroundColor3 = Color3.new(0, 0, 0),
            BackgroundTransparency = 0.4,
            Size = UDim2.new(1, 0, 1, 0), Parent = KeyGui,
        })

        local box = new("Frame", {
            BackgroundColor3 = Theme.Bg,
            Size = UDim2.new(0, 380, 0, 220),
            Position = UDim2.new(0.5, -190, 0.5, -110),
            BackgroundTransparency = 1, Parent = KeyGui,
        })
        corner(box, 12)
        local bs = stroke(box, Theme.StrokeAccent, 1, 1)
        padding(box, 22, 22, 22, 22)
        glow(box, Theme.Accent, 0.8)

        tween(box, Anim.Spring, { BackgroundTransparency = 0 })
        tween(bs, Anim.Smooth, { Transparency = 0 })

        new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24),
            Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Theme.Text,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = settings.KeySettings.Title or "Key System", Parent = box,
        })
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 28),
            Size = UDim2.new(1, 0, 0, 18),
            Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.Accent,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = settings.KeySettings.Subtitle or "", Parent = box,
        })
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 56),
            Size = UDim2.new(1, 0, 0, 36),
            Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.TextDim,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
            Text = settings.KeySettings.Note or "Enter your key.", Parent = box,
        })

        local inputBg = new("Frame", {
            BackgroundColor3 = Theme.Element,
            Position = UDim2.new(0, 0, 1, -78), Size = UDim2.new(1, 0, 0, 36),
            Parent = box,
        })
        corner(inputBg, 8)
        local inputStroke = stroke(inputBg, Theme.Stroke, 1)

        local input = new("TextBox", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0),
            Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.Text,
            PlaceholderText = "Enter key", PlaceholderColor3 = Theme.TextDark,
            Text = "", ClearTextOnFocus = false, Parent = inputBg,
        })
        track(input.Focused:Connect(function() tween(inputStroke, Anim.Fast, { Color = Theme.Accent }) end))
        track(input.FocusLost:Connect(function() tween(inputStroke, Anim.Fast, { Color = Theme.Stroke }) end))

        local btn = new("TextButton", {
            BackgroundColor3 = Theme.Accent,
            Position = UDim2.new(0, 0, 1, -32), Size = UDim2.new(1, 0, 0, 32),
            Font = Enum.Font.GothamBold, TextSize = 13,
            TextColor3 = Color3.fromRGB(255, 255, 255),
            Text = "Submit", AutoButtonColor = false, Parent = box,
        })
        corner(btn, 8)
        gradient(btn, { ColorSequenceKeypoint.new(0, Theme.AccentBright), ColorSequenceKeypoint.new(1, Theme.Accent) }, 90)

        track(btn.MouseEnter:Connect(function() tween(btn, Anim.Fast, { BackgroundColor3 = Theme.AccentBright }) end))
        track(btn.MouseLeave:Connect(function() tween(btn, Anim.Fast, { BackgroundColor3 = Theme.Accent }) end))

        local accepted = false
        local function submit()
            for _, k in ipairs(keys) do
                if input.Text == k then
                    accepted = true
                    tween(box, Anim.Smooth, { BackgroundTransparency = 1 })
                    tween(backdrop, Anim.Smooth, { BackgroundTransparency = 1 })
                    task.wait(0.3); KeyGui:Destroy(); return
                end
            end
            input.Text = ""; input.PlaceholderText = "Wrong key"
            local origPos = box.Position
            local s1 = TweenService:Create(box, TweenInfo.new(0.06, Enum.EasingStyle.Sine), { Position = origPos + UDim2.fromOffset(8, 0) })
            s1:Play(); s1.Completed:Wait()
            TweenService:Create(box, TweenInfo.new(0.12, Enum.EasingStyle.Elastic), { Position = origPos }):Play()
        end
        track(btn.MouseButton1Click:Connect(submit))
        track(input.FocusLost:Connect(function(enter) if enter then submit() end end))
        repeat task.wait() until accepted
    end

    -- Main GUI -----------------------------------------------------------
    local ScreenGui = new("ScreenGui", {
        Name = "PhantomUI", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true, DisplayOrder = 100,
    })
    parentGui(ScreenGui)

    local Main = new("Frame", {
        Name = "Main", BackgroundColor3 = Theme.Bg,
        Size = UDim2.new(0, 740, 0, 500),
        Position = UDim2.new(0.5, -370, 0.5, -250),
        BackgroundTransparency = 1, Parent = ScreenGui,
    })
    corner(Main, 12)
    local mainStroke = stroke(Main, Theme.Stroke, 1, 1)
    glow(Main, Theme.Accent, 0.85)

    -- Topbar -------------------------------------------------------------
    local Topbar = new("Frame", {
        Name = "Topbar", BackgroundColor3 = Theme.BgSoft,
        Size = UDim2.new(1, 0, 0, 56), Parent = Main,
    })
    corner(Topbar, 12)
    new("Frame", { -- mask bottom corners
        BackgroundColor3 = Theme.BgSoft, BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.new(1, 0, 0.5, 0),
        Parent = Topbar,
    })
    local accentLine = new("Frame", {
        BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -1), Size = UDim2.new(1, 0, 0, 1),
        Parent = Topbar,
    })
    gradient(accentLine, {
        ColorSequenceKeypoint.new(0, Theme.Bg),
        ColorSequenceKeypoint.new(0.5, Theme.Accent),
        ColorSequenceKeypoint.new(1, Theme.Bg),
    }, 0)

    local Logo = new("Frame", {
        BackgroundColor3 = Theme.Accent,
        Position = UDim2.new(0, 18, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(0, 26, 0, 26), Parent = Topbar,
    })
    corner(Logo, 7)
    gradient(Logo, { ColorSequenceKeypoint.new(0, Theme.AccentBright), ColorSequenceKeypoint.new(1, Theme.AccentDim) }, 135)
    glow(Logo, Theme.Accent, 0.4)

    new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 54, 0, 0), Size = UDim2.new(0, 200, 1, 0),
        Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = settings.Name or "Phantom", Parent = Topbar,
    })

    -- Search bar
    local SearchFrame = new("Frame", {
        BackgroundColor3 = Theme.Element,
        Position = UDim2.new(0, 240, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
        Size = UDim2.new(1, -340, 0, 34), Parent = Topbar,
    })
    corner(SearchFrame, 8)
    local searchStroke = stroke(SearchFrame, Theme.Stroke, 1)

    new("TextLabel", {
        BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0),
        Size = UDim2.new(0, 18, 1, 0),
        Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.TextDark,
        Text = "⌕", Parent = SearchFrame,
    })
    local SearchInput = new("TextBox", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 36, 0, 0), Size = UDim2.new(1, -46, 1, 0),
        Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Theme.Text,
        PlaceholderText = "Search", PlaceholderColor3 = Theme.TextDark,
        Text = "", TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false, Parent = SearchFrame,
    })
    track(SearchInput.Focused:Connect(function() tween(searchStroke, Anim.Fast, { Color = Theme.Accent }) end))
    track(SearchInput.FocusLost:Connect(function() tween(searchStroke, Anim.Fast, { Color = Theme.Stroke }) end))

    local function topbarBtn(text, xOff)
        local b = new("TextButton", {
            BackgroundColor3 = Theme.Element,
            Position = UDim2.new(1, xOff, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
            Size = UDim2.new(0, 34, 0, 34),
            Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Theme.TextDim,
            Text = text, AutoButtonColor = false, Parent = Topbar,
        })
        corner(b, 8); stroke(b, Theme.Stroke, 1)
        track(b.MouseEnter:Connect(function() tween(b, Anim.Fast, { BackgroundColor3 = Theme.ElementHover, TextColor3 = Theme.Text }) end))
        track(b.MouseLeave:Connect(function() tween(b, Anim.Fast, { BackgroundColor3 = Theme.Element, TextColor3 = Theme.TextDim }) end))
        return b
    end
    local MinBtn   = topbarBtn("−", -84)
    local CloseBtn = topbarBtn("✕", -42)

    -- Body ---------------------------------------------------------------
    local Body = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 1, -86),
        Parent = Main,
    })

    local Sidebar = new("Frame", {
        BackgroundColor3 = Theme.BgSoft, BorderSizePixel = 0,
        Size = UDim2.new(0, 200, 1, 0), Parent = Body,
    })
    new("Frame", {
        BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0,
        Position = UDim2.new(1, -1, 0, 0), Size = UDim2.new(0, 1, 1, 0),
        Parent = Sidebar,
    })
    padding(Sidebar, 12, 12, 12, 10)

    local TabList = new("ScrollingFrame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 0, BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Sidebar,
    })
    listLayout(TabList, 4)

    local Content = new("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 200, 0, 0),
        Size = UDim2.new(1, -200, 1, 0), Parent = Body,
    })
    padding(Content, 6, 6, 14, 14)
    local Pages = new("Frame", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0), Parent = Content,
    })

    -- Footer
    local Footer = new("Frame", {
        BackgroundColor3 = Theme.BgSoft,
        Position = UDim2.new(0, 0, 1, -30), Size = UDim2.new(1, 0, 0, 30),
        BorderSizePixel = 0, Parent = Main,
    })
    corner(Footer, 12)
    new("Frame", {
        BackgroundColor3 = Theme.BgSoft, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0.5, 0), Parent = Footer,
    })
    new("Frame", {
        BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 1), Parent = Footer,
    })
    new("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
        Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = Theme.TextDark,
        Text = (settings.LoadingSubtitle and settings.Name)
            and (settings.Name .. "  •  " .. settings.LoadingSubtitle)
            or (settings.Name or "Phantom"),
        Parent = Footer,
    })

    makeDraggable(Main, Topbar)

    -- Open animation
    Main.Size = UDim2.new(0, 0, 0, 0)
    Main.Position = UDim2.new(0.5, 0, 0.5, 0)
    Main.BackgroundTransparency = 0
    tween(Main, Anim.Spring, {
        Size = UDim2.new(0, 740, 0, 500),
        Position = UDim2.new(0.5, -370, 0.5, -250),
    })
    tween(mainStroke, Anim.Smooth, { Transparency = 0 })

    -- Search filtering
    local allElements = {}
    track(SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local q = string.lower(SearchInput.Text)
        for _, el in ipairs(allElements) do
            el.frame.Visible = q == "" or string.find(string.lower(el.name), q, 1, true) ~= nil
        end
    end))

    -- Hide hotkey
    local toggleKey = settings.ToggleUIKeybind or Enum.KeyCode.RightShift
    if type(toggleKey) == "string" then
        local ok = pcall(function() toggleKey = Enum.KeyCode[toggleKey] end)
        if not ok then toggleKey = Enum.KeyCode.RightShift end
    end
    local hidden = false
    track(UserInputService.InputBegan:Connect(function(input, processed)
        if not processed and input.KeyCode == toggleKey then
            hidden = not hidden
            if hidden then
                tween(Main, Anim.Smooth, { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 })
                tween(mainStroke, Anim.Fast, { Transparency = 1 })
            else
                tween(Main, Anim.Spring, { Size = UDim2.new(0, 740, 0, 500), BackgroundTransparency = 0 })
                tween(mainStroke, Anim.Smooth, { Transparency = 0 })
            end
        end
    end))

    -- Min / close
    local minimized = false
    track(MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            tween(Main, Anim.Smooth, { Size = UDim2.new(0, 740, 0, 56) })
            task.delay(0.15, function() Body.Visible = false; Footer.Visible = false end)
        else
            Body.Visible = true; Footer.Visible = true
            tween(Main, Anim.Spring, { Size = UDim2.new(0, 740, 0, 500) })
        end
    end))
    track(CloseBtn.MouseButton1Click:Connect(function()
        tween(Main, Anim.Smooth, { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 })
        tween(mainStroke, Anim.Fast, { Transparency = 1 })
        task.wait(0.3); ScreenGui:Destroy()
    end))

    -- Configuration ------------------------------------------------------
    local cfg = settings.ConfigurationSaving or {}
    local cfgEnabled = cfg.Enabled and fsAvailable()
    local cfgFolder = cfg.FolderName and (CFG_FOLDER .. "/" .. cfg.FolderName) or CFG_FOLDER
    local cfgFile = cfg.FileName or tostring(game.PlaceId)
    local cfgPath = cfgFolder .. "/" .. cfgFile .. CFG_EXT
    local cfgLoaded = false

    if cfgEnabled then ensureFolder(CFG_FOLDER); ensureFolder(cfgFolder) end

    local function saveCfg()
        if not cfgEnabled or not cfgLoaded then return end
        local data = {}
        for k, v in pairs(Phantom.Flags) do
            if v.Type == "Toggle" or v.Type == "Slider" or v.Type == "Input" then
                data[k] = v.CurrentValue
            elseif v.Type == "Dropdown" then
                data[k] = v.CurrentOption
            elseif v.Type == "Keybind" then
                data[k] = v.CurrentKeybind
            elseif v.Type == "ColorPicker" then
                data[k] = { v.Color.R, v.Color.G, v.Color.B }
            end
        end
        pcall(writefile, cfgPath, HttpService:JSONEncode(data))
    end

    local function loadCfg()
        if not cfgEnabled then cfgLoaded = true; return end
        if not isfile(cfgPath) then cfgLoaded = true; return end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(cfgPath)) end)
        if ok and type(data) == "table" then
            for k, v in pairs(data) do
                local flag = Phantom.Flags[k]
                if flag and flag.Set then
                    pcall(function()
                        if flag.Type == "ColorPicker" and type(v) == "table" then
                            flag:Set(Color3.new(v[1], v[2], v[3]))
                        else
                            flag:Set(v)
                        end
                    end)
                end
            end
        end
        cfgLoaded = true
    end

