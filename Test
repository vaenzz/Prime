    SearchStroke.Parent = SearchFrame

    local SearchIcon = Instance.new("ImageLabel")
    SearchIcon.Parent = SearchFrame
    SearchIcon.Position = UDim2.new(0, 10, 0.5, -8)
    SearchIcon.Size = UDim2.new(0, 16, 0, 16)
    SearchIcon.Image = "rbxassetid://6031154667"
    SearchIcon.ImageColor3 = Config.Theme.TextMuted
    SearchIcon.BackgroundTransparency = 1

    local SearchInput = Instance.new("TextBox")
    SearchInput.Name = "SearchInput"
    SearchInput.Parent = SearchFrame
    SearchInput.Size = UDim2.new(1, -40, 1, 0)
    SearchInput.Position = UDim2.new(0, 35, 0, 0)
    SearchInput.BackgroundTransparency = 1
    SearchInput.Text = ""
    SearchInput.PlaceholderText = "Search features..."
    SearchInput.PlaceholderColor3 = Config.Theme.TextMuted
    SearchInput.TextColor3 = Config.Theme.Text
    SearchInput.Font = Enum.Font.Gotham
    SearchInput.TextSize = 13
    SearchInput.TextXAlignment = Enum.TextXAlignment.Left

    -- Silnik Wyszukiwania (Style: Rayfield Filter)
    SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local Query = SearchInput.Text:lower()
        local ActiveTab = Window.ActiveTab

        if ActiveTab then
            Utils:Tween(SearchStroke, {Color = Query ~= "" and Config.Theme.Accent or Config.Theme.Outline}, 0.2)
            
            for _, Element in pairs(ActiveTab.Page:GetChildren()) do
                if Element:IsA("Frame") or Element:IsA("TextButton") then
                    -- Przeszukujemy po nazwie elementu (zapisanej w Name)
                    local TargetText = Element.Name:lower()
                    
                    if Query == "" or TargetText:find(Query) then
                        Element.Visible = true
                        Utils:Tween(Element, {GroupTransparency = 0}, 0.2)
                    else
                        task.spawn(function()
                            Utils:Tween(Element, {GroupTransparency = 1}, 0.2)
                            task.wait(0.2)
                            if SearchInput.Text:lower() ~= "" then -- Sprawdzenie czy wciąż szukamy
                                Element.Visible = false
                            end
                        end)
                    end
                end
            end
        end
    end)

    -- Animacja fokusu
    SearchInput.Focused:Connect(function()
        Utils:Tween(SearchStroke, {Thickness = 1.5, Color = Config.Theme.Accent}, 0.2)
    end)

    SearchInput.FocusLost:Connect(function()
        Utils:Tween(SearchStroke, {Thickness = 1, Color = SearchInput.Text ~= "" and Config.Theme.Accent or Config.Theme.Outline}, 0.2)
    end)

    Window.SearchInput = SearchInput
end

