                BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.4,
                Size = UDim2.new(1, 0, 0, 30),
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "  " .. text, Parent = container,
            })
            corner(Lbl, 6); stroke(Lbl, Theme.Stroke, 1, 0.5)
            return { Set = function(_, t) Lbl.Text = "  " .. t end }
        end

        function Tab:CreateParagraph(c)
            local container = ensureSection()
            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.3,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y, Parent = container,
            })
            corner(Frame, 6); stroke(Frame, Theme.Stroke, 1, 0.5)
            padding(Frame, 10, 10, 14, 14)
            local Title = new("TextLabel", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18),
                Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = c.Title or "", Parent = Frame,
            })
            local Content = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 22),
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
                Text = c.Content or "", Parent = Frame,
            })
            return { Set = function(_, n) Title.Text = n.Title or ""; Content.Text = n.Content or "" end }
        end

        function Tab:CreateDivider()
            local container = ensureSection()
            new("Frame", {
                BackgroundColor3 = Theme.Stroke, BackgroundTransparency = 0.5,
                Size = UDim2.new(1, 0, 0, 1), Parent = container,
            })
            return { Set = function() end }
        end

        function Tab:CreateColorPicker(c)
            local container = ensureSection()
            local obj = {
                Type = "ColorPicker",
                Color = c.Color or Color3.fromRGB(255, 255, 255),
                Callback = c.Callback,
            }

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 38),
                ClipsDescendants = true, Parent = container,
            })
            corner(Frame, 8); stroke(Frame, Theme.Stroke, 1)

            local Header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = Frame })
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0), Size = UDim2.new(1, -64, 1, 0),
                Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = c.Name, Parent = Header,
            })
            local Swatch = new("Frame", {
                BackgroundColor3 = obj.Color,
                Position = UDim2.new(1, -42, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 28, 0, 22), Parent = Header,
            })
            corner(Swatch, 4); stroke(Swatch, Theme.StrokeStrong, 1)
            local Click = new("TextButton", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                Text = "", AutoButtonColor = false, Parent = Header,
            })

            local Picker = new("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(1, 0, 0, 130),
                Parent = Frame,
            })
            padding(Picker, 0, 12, 14, 14)

            local SV = new("ImageLabel", {
                BackgroundColor3 = obj.Color,
                Size = UDim2.new(1, -100, 1, 0),
                Image = "rbxassetid://4155801252", Parent = Picker,
            })
            corner(SV, 6); stroke(SV, Theme.Stroke, 1)
            local SVCursor = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.new(0, 8, 0, 8),
                AnchorPoint = Vector2.new(0.5, 0.5), Parent = SV,
            })
            corner(SVCursor, 4); stroke(SVCursor, Color3.new(0,0,0), 1)

            local Hue = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Position = UDim2.new(1, -90, 0, 0),
                Size = UDim2.new(0, 14, 1, 0), Parent = Picker,
            })
            corner(Hue, 4); stroke(Hue, Theme.Stroke, 1)
            gradient(Hue, {
                ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0, 0)),
                ColorSequenceKeypoint.new(0.16, Color3.fromRGB(255, 255, 0)),
                ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(0, 255, 255)),
                ColorSequenceKeypoint.new(0.66, Color3.fromRGB(0, 0, 255)),
                ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0, 0)),
            }, 90)
            local HueCursor = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.new(1, 4, 0, 3),
                Position = UDim2.new(0, -2, 0, 0), Parent = Hue,
            })
            corner(HueCursor, 1)

            local Preview = new("Frame", {
                BackgroundColor3 = obj.Color,
                Position = UDim2.new(1, -68, 0, 0),
                Size = UDim2.new(0, 68, 0, 36), Parent = Picker,
            })
            corner(Preview, 6); stroke(Preview, Theme.Stroke, 1)

            local h, s, v = obj.Color:ToHSV()

            local function refreshColor()
                obj.Color = Color3.fromHSV(h, s, v)
                Swatch.BackgroundColor3 = obj.Color
                Preview.BackgroundColor3 = obj.Color
                SV.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                SVCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                HueCursor.Position = UDim2.new(0, -2, h, -1)
                pcall(c.Callback, obj.Color); saveCfg()
            end
            refreshColor()

            local svDown, hueDown = false, false
            local function svUpdate(input)
                local rx = (input.Position.X - SV.AbsolutePosition.X) / SV.AbsoluteSize.X
                local ry = (input.Position.Y - SV.AbsolutePosition.Y) / SV.AbsoluteSize.Y
                s = math.clamp(rx, 0, 1); v = 1 - math.clamp(ry, 0, 1)
                refreshColor()
            end
            local function hueUpdate(input)
                local ry = (input.Position.Y - Hue.AbsolutePosition.Y) / Hue.AbsoluteSize.Y
                h = math.clamp(ry, 0, 1); refreshColor()
            end
            track(SV.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDown = true; svUpdate(input)
                end
            end))
            track(Hue.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    hueDown = true; hueUpdate(input)
                end
            end))
            track(UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                    if svDown then svUpdate(input) end
                    if hueDown then hueUpdate(input) end
                end
            end))
            track(UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    svDown = false; hueDown = false
                end
            end))

            local open = false
            track(Click.MouseButton1Click:Connect(function()
                open = not open
                tween(Frame, Anim.Smooth, { Size = UDim2.new(1, 0, 0, open and 174 or 38) })
            end))

            function obj:Set(col)
                obj.Color = col; h, s, v = col:ToHSV(); refreshColor()
            end
            if c.Flag then Phantom.Flags[c.Flag] = obj end
            table.insert(allElements, { frame = Frame, name = c.Name })
            return obj
        end

        return Tab
    end

    function Window:Destroy() Phantom:Destroy() end
    function Window:ModifyTheme() end -- no-op for compat

    task.delay(0.5, function() loadCfg() end)

    return Window
end

-- API parity / cleanup ---------------------------------------------------
function Phantom:LoadConfiguration() end

function Phantom:SetVisibility(v)
    for _, gui in ipairs(CoreGui:GetChildren()) do
        if gui.Name == "PhantomUI" then gui.Enabled = v and true or false end
    end
end

function Phantom:Destroy()
    for _, conn in ipairs(self._connections) do pcall(function() conn:Disconnect() end) end
    self._connections = {}
    local function cleanIn(parent)
        for _, gui in ipairs(parent:GetChildren()) do
            if gui.Name == "PhantomUI" or gui.Name == "PhantomNotifs" or gui.Name == "PhantomKey" then
                gui:Destroy()
            end
        end
    end
    pcall(cleanIn, CoreGui)
    pcall(function() if gethui then cleanIn(gethui()) end end)
end

return Phantom
