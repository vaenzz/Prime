            })
            corner(Knob, 7)
            stroke(Knob, Theme.Accent, 2)
            glow(Knob, Theme.Accent, 0.4)

            local function setVisual(val, animate)
                local pct = (val - c.Range[1]) / (c.Range[2] - c.Range[1])
                pct = math.clamp(pct, 0, 1)
                local info = animate ~= false and Anim.Fast or TweenInfo.new(0)
                TweenService:Create(Fill, info, { Size = UDim2.new(pct, 0, 1, 0) }):Play()
                TweenService:Create(Knob, info, { Position = UDim2.new(pct, 0, 0.5, 0) }):Play()
                ValueLabel.Text = tostring(val) .. (c.Suffix and (" " .. c.Suffix) or "")
            end
            setVisual(obj.CurrentValue, false)

            local dragging = false
            local function updateFromInput(input)
                local rel = (input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X
                rel = math.clamp(rel, 0, 1)
                local val = c.Range[1] + (c.Range[2] - c.Range[1]) * rel
                local inc = c.Increment or 1
                val = math.floor(val / inc + 0.5) * inc
                val = math.clamp(val, c.Range[1], c.Range[2])
                if val ~= obj.CurrentValue then
                    obj.CurrentValue = val; setVisual(val)
                    pcall(c.Callback, val); saveCfg()
                end
            end

            track(Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; updateFromInput(input)
                    tween(Knob, Anim.Fast, { Size = UDim2.new(0, 18, 0, 18) })
                end
            end))
            track(UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateFromInput(input)
                end
            end))
            track(UserInputService.InputEnded:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    dragging = false; tween(Knob, Anim.Spring, { Size = UDim2.new(0, 14, 0, 14) })
                end
            end))
            attachHover(Frame)

            function obj:Set(v)
                v = math.clamp(v, c.Range[1], c.Range[2])
                obj.CurrentValue = v; setVisual(v); pcall(c.Callback, v)
            end

            if c.Flag then Phantom.Flags[c.Flag] = obj end
            table.insert(allElements, { frame = Frame, name = c.Name })
            return obj
        end

