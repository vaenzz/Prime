function Phantom:Notify(data)
    ensureNotifGui()
    data = data or {}

    -- Determine accent color from type
    local typeColor = Theme.Accent
    local typeColorBright = Theme.AccentBright
    local typeColorDim = Theme.AccentDim
    if data.Type == "success" then
        typeColor = Theme.Success; typeColorBright = Theme.Success; typeColorDim = Theme.Success
    elseif data.Type == "warning" then
        typeColor = Theme.Warning; typeColorBright = Theme.Warning; typeColorDim = Theme.Warning
    elseif data.Type == "error" then
        typeColor = Theme.Error; typeColorBright = Theme.Error; typeColorDim = Theme.Error
    end

    local notif = new("Frame", {
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = NotifGui.List,
    })
    corner(notif, 12)
    local s = stroke(notif, Theme.Stroke, 1, 1)
    pad(notif, 14, 14, 18, 18)
    shadow(notif, 0.6)
    gradient(notif, { Theme.BgGradient1, Theme.Panel }, 135)

    local accent = new("Frame", {
        BackgroundColor3 = typeColor,
        Position = UDim2.new(0, -18, 0, -14),
        Size = UDim2.new(0, 3, 1, 28),
        BackgroundTransparency = 1,
        Parent = notif,
    })
    gradient(accent, { typeColorBright, typeColor, typeColorDim }, 90)

    local title = new("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        Font = Enum.Font.GothamBold, TextSize = 14,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = data.Title or "Notification",
        TextTransparency = 1,
        Parent = notif,
    })
    local content = new("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 22),
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = data.Content or "",
        TextTransparency = 1,
        Parent = notif,
    })

    notif.Position = UDim2.new(1, 100, 0, 0)
    tween(notif, Anim.Slide, { BackgroundTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
    tween(s, Anim.Smooth, { Transparency = 0 })
    tween(accent, Anim.Smooth, { BackgroundTransparency = 0 })
    tween(title, Anim.Smooth, { TextTransparency = 0 })
    tween(content, Anim.Smooth, { TextTransparency = 0.15 })

    task.delay(data.Duration or 4, function()
        if not notif.Parent then return end
        tween(notif, Anim.Smooth, { BackgroundTransparency = 1, Position = UDim2.new(1, 100, 0, 0) })
        tween(s, Anim.Smooth, { Transparency = 1 })
        tween(accent, Anim.Smooth, { BackgroundTransparency = 1 })
        tween(title, Anim.Smooth, { TextTransparency = 1 })
        tween(content, Anim.Smooth, { TextTransparency = 1 })
        task.wait(0.5)
        notif:Destroy()
    end)
end

