-- Zaawansowany Tween z obsługą EasingStyle (Fluent/MacLib feel)
function Utils:Tween(obj, prop, time, style, dir)
    local info = TweenInfo.new(
        time or 0.3, 
        style or Enum.EasingStyle.Quart, 
        dir or Enum.EasingDirection.Out
    )
    local tween = TweenService:Create(obj, info, prop)
    tween:Play()
    return tween
end

-- System generowania unikalnych nazw (Ochrona przed detekcją)
function Utils:GenerateID()
    return HttpService:GenerateGUID(false):gsub("-", ""):sub(1, 12)
end

-- Obsługa połączeń (Connection Manager - zapobiega lagom)
function Utils:Connect(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(Phantom.Connections, connection)
    return connection
end

