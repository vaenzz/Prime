local TooltipGui, TooltipFrame, TooltipLabel
local function ensureTooltip()
    if TooltipGui and TooltipGui.Parent then return end
    TooltipGui = new("ScreenGui", {
        Name = "PhantomTooltip", IgnoreGuiInset = true, ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 99999,
    })
    parentGui(TooltipGui)
    TooltipFrame = new("Frame", {
        BackgroundColor3 = Theme.Bg, Visible = false,
        AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, 0, 0, 0),
        Parent = TooltipGui,
    })
    corner(TooltipFrame, 8)
    stroke(TooltipFrame, Theme.StrokeAccent, 1)
    pad(TooltipFrame, 8, 8, 12, 12)
    gradient(TooltipFrame, { Theme.PanelGradient1, Theme.PanelGradient2 }, 90)
    TooltipLabel = new("TextLabel", {
        BackgroundTransparency = 1, AutomaticSize = Enum.AutomaticSize.XY,
        Size = UDim2.new(0, 0, 0, 0),
        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.Text, TextWrapped = false,
        Text = "", Parent = TooltipFrame,
    })
end

local function showTooltip(text, x, y)
    if not Phantom.Config.TooltipsEnabled then return end
    ensureTooltip()
    TooltipLabel.Text = text
    TooltipFrame.Visible = true
    TooltipFrame.Position = UDim2.new(0, x + 14, 0, y + 14)
end
local function hideTooltip()
    if TooltipFrame then TooltipFrame.Visible = false end
end

local function attachTooltip(element, text)
    if not text or text == "" then return end
    element.MouseEnter:Connect(function()
        local mp = UserInputService:GetMouseLocation()
        showTooltip(text, mp.X, mp.Y)
    end)
    element.MouseMoved:Connect(function(x, y)
        if TooltipFrame and TooltipFrame.Visible then
            TooltipFrame.Position = UDim2.new(0, x + 14, 0, y + 14)
        end
    end)
    element.MouseLeave:Connect(hideTooltip)
end

