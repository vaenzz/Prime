local function tintIcons(icons, color)
    for _, ic in ipairs(icons) do
        if ic:IsA("Frame") then
            tween(ic, Anim.Fast, { BackgroundColor3 = color })
        end
    end
    if icons._stroke then
        tween(icons._stroke, Anim.Fast, { Color = color })
    end
end

