        ----------------------------------------------------------------
        function Tab:CreateSlider(cfg)
            local container = ensureSection()
            local rmin, rmax = cfg.Range[1], cfg.Range[2]
            local obj = {
                Type = "Slider",
                CurrentValue = cfg.CurrentValue or rmin,
                Callback = cfg.Callback,
            }

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 60),
                Parent = container,
            })
            corner(Frame, 10)
            local frameStroke = stroke(Frame, Theme.Stroke, 1)

            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 8),
                Size = UDim2.new(0.6, -14, 0, 18),
                Font = Enum.Font.GothamMedium, TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = cfg.Name, Parent = Frame,
            })

            local ValueBg = new("Frame", {
                BackgroundColor3 = Theme.Bg,
                Position = UDim2.new(1, -76, 0, 8),
                Size = UDim2.new(0, 62, 0, 18),
                Parent = Frame,
            })
            corner(ValueBg, 6)
            stroke(ValueBg, Theme.Stroke, 1)
            local ValueLabel = new("TextLabel", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                Font = Enum.Font.Gotham, TextSize = 11,
                TextColor3 = Theme.Accent,
                Text = tostring(obj.CurrentValue) .. (cfg.Suffix and (" " .. cfg.Suffix) or ""),
                Parent = ValueBg,
            })

            local Track = new("Frame", {
                BackgroundColor3 = Theme.Bg,
                Position = UDim2.new(0, 14, 1, -18),
                Size = UDim2.new(1, -28, 0, 6),
                Parent = Frame,
            })
            corner(Track, 3)
            stroke(Track, Theme.Stroke, 1)

            local Fill = new("Frame", {
                BackgroundColor3 = Theme.Accent,
                Size = UDim2.new(0, 0, 1, 0),
                Parent = Track,
            })
            corner(Fill, 3)
            gradient(Fill, { Theme.AccentBright, Theme.Accent }, 0)

            local Knob = new("Frame", {
                BackgroundColor3 = Theme.TextBright,
                Position = UDim2.new(0, 0, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Size = UDim2.new(0, 14, 0, 14),
                Parent = Track,
            })
            corner(Knob, 7)
            stroke(Knob, Theme.Accent, 2)
            glow(Knob, Theme.AccentGlow, 10, 0.6)

            local function setVisual(val, animated)
                local pct = math.clamp((val - rmin) / (rmax - rmin), 0, 1)
                local info = animated and Anim.Fast or TweenInfo.new(0)
                tween(Fill, info, { Size = UDim2.new(pct, 0, 1, 0) })
                tween(Knob, info, { Position = UDim2.new(pct, 0, 0.5, 0) })
                ValueLabel.Text = tostring(val) .. (cfg.Suffix and (" " .. cfg.Suffix) or "")
            end
            setVisual(obj.CurrentValue, false)

            local dragging = false
            local function update(input)
                local rel = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                local val = rmin + (rmax - rmin) * rel
                local inc = cfg.Increment or 1
                val = math.floor(val / inc + 0.5) * inc
                val = math.clamp(val, rmin, rmax)
                if val ~= obj.CurrentValue then
                    obj.CurrentValue = val
                    setVisual(val, true)
                    pcall(cfg.Callback, val)
                end
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    tween(Knob, Anim.Fast, { Size = UDim2.new(0, 18, 0, 18) })
                    update(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging
                and (input.UserInputType == Enum.UserInputType.MouseMovement
                  or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        tween(Knob, Anim.Fast, { Size = UDim2.new(0, 14, 0, 14) })
                        saveConfig()
                    end
                end
            end)

            Frame.MouseEnter:Connect(function()
                tween(Frame, Anim.Fast, { BackgroundColor3 = Theme.ElementHover })
                tween(frameStroke, Anim.Fast, { Color = Theme.StrokeAccent })
            end)
            Frame.MouseLeave:Connect(function()
                tween(Frame, Anim.Fast, { BackgroundColor3 = Theme.Element })
                tween(frameStroke, Anim.Fast, { Color = Theme.Stroke })
            end)

            function obj:Set(v)
                v = math.clamp(v, rmin, rmax)
                obj.CurrentValue = v
                setVisual(v, true)
                pcall(cfg.Callback, v)
                saveConfig()
            end

            if cfg.Flag then Phantom.Flags[cfg.Flag] = obj end
            fadeInElement(Frame)
            table.insert(allElements, { frame = Frame, name = cfg.Name })
            return obj
        end

