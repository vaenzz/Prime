        Font = Enum.Font.Gotham, TextSize = 12,
        TextColor3 = Theme.TextDim,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        Text = data.Content or "",
        TextTransparency = 1, Parent = notif,
    })

    -- Slide in
    notif.Position = UDim2.new(1, 100, 0, 0)
    tween(notif, Anim.Slide, { BackgroundTransparency = 0, Position = UDim2.new(0, 0, 0, 0) })
    tween(s, Anim.Smooth, { Transparency = 0 })
    tween(iconBg, Anim.Smooth, { BackgroundTransparency = 0 })
    tween(iconStroke, Anim.Smooth, { Transparency = 0 })
    tween(title, Anim.Smooth, { TextTransparency = 0 })
    tween(content, Anim.Smooth, { TextTransparency = 0.15 })

    task.delay(data.Duration or 4, function()
        if not notif.Parent then return end
        tween(notif, Anim.Smooth, { BackgroundTransparency = 1, Position = UDim2.new(1, 100, 0, 0) })
        tween(s, Anim.Smooth, { Transparency = 1 })
        tween(iconBg, Anim.Smooth, { BackgroundTransparency = 1 })
        tween(iconStroke, Anim.Smooth, { Transparency = 1 })
        tween(title, Anim.Smooth, { TextTransparency = 1 })
        tween(content, Anim.Smooth, { TextTransparency = 1 })
        task.wait(0.5); notif:Destroy()
    end)
end

