        ----------------------------------------------------------------
        -- Color Picker
        ----------------------------------------------------------------
        function Tab:CreateColorPicker(cfg)
            local container = ensureSection()
            maybeAddDivider(container)

            local obj = {
                Type = "ColorPicker",
                Color = cfg.Color or Color3.fromRGB(0, 170, 255),
                Callback = cfg.Callback,
            }

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 38),
                AutomaticSize = Enum.AutomaticSize.Y,
                ClipsDescendants = true, Parent = container,
            })
            corner(Frame, 10)
            local frameStroke = stroke(Frame, Theme.Stroke, 1)

            local Header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = Frame })
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(1, -56, 1, 0),
                Font = Enum.Font.GothamMedium, TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = cfg.Name, Parent = Header,
            })
            local Swatch = new("Frame", {
                BackgroundColor3 = obj.Color,
                Position = UDim2.new(1, -38, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 26, 0, 22), Parent = Header,
            })
            corner(Swatch, 8)
            stroke(Swatch, Theme.Stroke, 1)

            local Click = new("TextButton", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                Text = "", AutoButtonColor = false, Parent = Header,
            })

            local Body = new("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 38),
                Size = UDim2.new(1, -28, 0, 130),
                Visible = false, Parent = Frame,
            })

            local SVBox = new("Frame", {
                BackgroundColor3 = Color3.fromHSV(0, 1, 1),
                Size = UDim2.new(0, 130, 0, 110), Parent = Body,
            })
            corner(SVBox, 8)
            stroke(SVBox, Theme.Stroke, 1)
            new("UIGradient", {
                Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255)),
                Transparency = NumberSequence.new(0, 1), Parent = SVBox,
            })
            local svDark = new("Frame", {
                BackgroundColor3 = Color3.new(0, 0, 0),
                Size = UDim2.new(1, 0, 1, 0), BorderSizePixel = 0, Parent = SVBox,
            })
            corner(svDark, 8)
            new("UIGradient", {
                Color = ColorSequence.new(Color3.new(0, 0, 0), Color3.new(0, 0, 0)),
                Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = svDark,
            })
            local svKnob = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.new(0, 10, 0, 10),
                AnchorPoint = Vector2.new(0.5, 0.5), Parent = SVBox,
            })
            corner(svKnob, 5)
            stroke(svKnob, Theme.Bg, 2)

            local HueBar = new("Frame", {
                BackgroundColor3 = Color3.new(1, 1, 1),
                Position = UDim2.new(0, 140, 0, 0),
                Size = UDim2.new(1, -140, 0, 110), Parent = Body,
            })
            corner(HueBar, 8)
            stroke(HueBar, Theme.Stroke, 1)
            new("UIGradient", {
                Color = ColorSequence.new({
                    ColorSequenceKeypoint.new(0,    Color3.fromRGB(255, 0, 0)),
                    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
                    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
                    ColorSequenceKeypoint.new(0.5,  Color3.fromRGB(0, 255, 255)),
                    ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
                    ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
                    ColorSequenceKeypoint.new(1,    Color3.fromRGB(255, 0, 0)),
                }),
                Rotation = 90, Parent = HueBar,
            })
            local hueKnob = new("Frame", {
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                Size = UDim2.new(1, 4, 0, 3),
                Position = UDim2.new(0.5, 0, 0, 0),
                AnchorPoint = Vector2.new(0.5, 0.5), Parent = HueBar,
            })
            corner(hueKnob, 2)

            local h, s, v = obj.Color:ToHSV()
            local function applyColor()
                local c = Color3.fromHSV(h, s, v)
                obj.Color = c; Swatch.BackgroundColor3 = c
                SVBox.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                svKnob.Position = UDim2.new(s, 0, 1 - v, 0)
                hueKnob.Position = UDim2.new(0.5, 0, h, 0)
                pcall(cfg.Callback, c)
            end
            applyColor()

            local svDrag, hueDrag = false, false
            SVBox.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then svDrag = true end
            end)
            HueBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then hueDrag = true end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                    if svDrag or hueDrag then saveConfig() end
                    svDrag, hueDrag = false, false
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
                if svDrag then
                    local rx = math.clamp((input.Position.X - SVBox.AbsolutePosition.X) / SVBox.AbsoluteSize.X, 0, 1)
                    local ry = math.clamp((input.Position.Y - SVBox.AbsolutePosition.Y) / SVBox.AbsoluteSize.Y, 0, 1)
                    s = rx; v = 1 - ry; applyColor()
                end
                if hueDrag then
                    local ry = math.clamp((input.Position.Y - HueBar.AbsolutePosition.Y) / HueBar.AbsoluteSize.Y, 0, 1)
                    h = ry; applyColor()
                end
            end)

            local open = false
            Click.MouseButton1Click:Connect(function()
                open = not open
                Body.Visible = open
                tween(Frame, Anim.Smooth, { Size = UDim2.new(1, 0, 0, open and 180 or 38) })
            end)

            Frame.MouseEnter:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.StrokeAccent }) end)
            Frame.MouseLeave:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.Stroke }) end)

            attachTooltip(Frame, cfg.Tooltip)

            function obj:Set(c)
                obj.Color = c; h, s, v = c:ToHSV()
                applyColor(); saveConfig()
            end

            if cfg.Flag then Phantom.Flags[cfg.Flag] = obj end
            fadeInElement(Frame)
            table.insert(allElements, { frame = Frame, name = cfg.Name })
            return obj
        end

        return Tab
    end

    function Window:Destroy() ScreenGui:Destroy() end

    function Window:ModifyTheme(themeName)
        if Phantom.Themes[themeName] then
            Theme = Phantom.Themes[themeName]
            Phantom:Notify({ Title = "Theme Changed", Content = "Switched to " .. themeName, Type = "success", Duration = 3 })
        end
    end

    -- BUILT-IN SETTINGS TAB
    task.delay(0.1, function()
        local SettingsTab = Window:CreateTab("Settings")
        SettingsTab:CreateSection("Theme")
        local themeOptions = {}
        for k in pairs(Phantom.Themes) do table.insert(themeOptions, k) end
        SettingsTab:CreateDropdown({
            Name = "UI Theme",
            Options = themeOptions,
            CurrentOption = settings.Theme or "Default",
            MultipleOptions = false,
            Tooltip = "Switch the accent color scheme",
            Callback = function(opt)
                if opt and opt[1] then Window:ModifyTheme(opt[1]) end
            end,
        })

        SettingsTab:CreateSection("Window")
        SettingsTab:CreateButton({
            Name = "Reset Window Size",
            Tooltip = "Restore the default window dimensions",
            Callback = function()
                resized = false
                tween(Main, Anim.Smooth, { Size = windowSize })
            end,
        })
        SettingsTab:CreateButton({
            Name = "Center Window",
            Tooltip = "Move the window to the center of the screen",
            Callback = function()
                tween(Main, Anim.Smooth, { Position = UDim2.new(0.5, 0, 0.5, 0) })
            end,
        })
        SettingsTab:CreateToggle({
            Name = "Tooltips",
            CurrentValue = Phantom.Config.TooltipsEnabled,
            Callback = function(v) Phantom.Config.TooltipsEnabled = v end,
        })

        SettingsTab:CreateSection("Info")
        SettingsTab:CreateParagraph({
            Title = "Phantom v" .. Phantom.Version,
            Content = "Black + Electric Blue UI library. Press the toggle key to minimize/restore the window.",
        })
    end)

    task.delay(2.5, loadConfig)
    return Window
end

function Phantom:LoadConfiguration() end
function Phantom:SaveConfiguration() end
function Phantom:Destroy()
    local function nuke(parent)
        for _, gui in ipairs(parent:GetChildren()) do
            if gui.Name == "PhantomUI" or gui.Name == "PhantomNotifications"
            or gui.Name == "PhantomKey" or gui.Name == "PhantomTooltip" then
                gui:Destroy()
            end
        end
    end
    pcall(function() nuke(CoreGui) end)
    pcall(function() if gethui then nuke(gethui()) end end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then nuke(pg) end
    end)
end

return Phantom
