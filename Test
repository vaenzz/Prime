    local cfgPath = CFG_FOLDER .. "/" .. cfgFileName .. CFG_EXT
    if cfgEnabled then ensureFolder("Phantom"); ensureFolder(CFG_FOLDER) end

    local function saveConfig()
        if not cfgEnabled then return end
        local data = {}
        for flag, el in pairs(Phantom.Flags) do
            if el.Type == "Toggle"      then data[flag] = el.CurrentValue
            elseif el.Type == "Slider"   then data[flag] = el.CurrentValue
            elseif el.Type == "Input"    then data[flag] = el.CurrentValue
            elseif el.Type == "Keybind"  then data[flag] = el.CurrentKeybind
            elseif el.Type == "Dropdown" then data[flag] = el.CurrentOption
            elseif el.Type == "ColorPicker" then
                data[flag] = { R = el.Color.R, G = el.Color.G, B = el.Color.B }
            end
        end
        local ok, json = pcall(HttpService.JSONEncode, HttpService, data)
        if ok then safeWrite(cfgPath, json) end
    end

    local function loadConfig()
        if not cfgEnabled then return end
        local content = safeRead(cfgPath)
        if not content then return end
        local ok, data = pcall(HttpService.JSONDecode, HttpService, content)
        if not ok or type(data) ~= "table" then return end
        for flag, val in pairs(data) do
            local el = Phantom.Flags[flag]
            if el and el.Set then
                if el.Type == "ColorPicker" and type(val) == "table" then
                    pcall(el.Set, el, Color3.new(val.R, val.G, val.B))
                else
                    pcall(el.Set, el, val)
                end
            end
        end
    end

