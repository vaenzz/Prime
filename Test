-- RIPPLE + HOVER SCALE
------------------------------------------------------------------------------
local function ripple(parent, x, y)
    local r = new("Frame", {
        BackgroundColor3 = Theme.AccentBright, BackgroundTransparency = 0.7,
        Position = UDim2.new(0, x - parent.AbsolutePosition.X, 0, y - parent.AbsolutePosition.Y),
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(0, 0, 0, 0),
        BorderSizePixel = 0, ZIndex = (parent.ZIndex or 1) + 1, Parent = parent,
    })
    corner(r, 999)
    local size = math.max(parent.AbsoluteSize.X, parent.AbsoluteSize.Y) * 2
    tween(r, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, size, 0, size), BackgroundTransparency = 1,
    })
    task.delay(0.5, function() r:Destroy() end)
end
local function attachRipple(button)
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            ripple(button, input.Position.X, input.Position.Y)
        end
    end)
end
local function attachHoverScale(button, scale)
    scale = scale or 1.02
    local s = new("UIScale", { Scale = 1, Parent = button })
    button.MouseEnter:Connect(function() tween(s, Anim.Fast, { Scale = scale }) end)
    button.MouseLeave:Connect(function() tween(s, Anim.Fast, { Scale = 1 }) end)
    return s
end

