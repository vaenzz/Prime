local HttpService = game:GetService("HttpService")

function Phantom:SaveConfig(name)
    local FolderName = "Phantom_Configs"
    if not isfolder(FolderName) then makefolder(FolderName) end
    
    local Data = {}
    for flag, value in pairs(self.Flags) do
        -- Konwersja typów specjalnych na format JSON-friendly
        if typeof(value) == "Color3" then
            Data[flag] = {R = value.R, G = value.G, B = value.B, Type = "Color3"}
        elseif typeof(value) == "EnumItem" then
            Data[flag] = {Value = tostring(value), Type = "Enum"}
        else
            Data[flag] = value
        end
    end
    
    local FileName = FolderName .. "/" .. (name or "Default") .. ".json"
    writefile(FileName, HttpService:JSONEncode(Data))
end

function Phantom:LoadConfig(name)
    local FileName = "Phantom_Configs/" .. (name or "Default") .. ".json"
    if not isfile(FileName) then return end
    
    local RawData = readfile(FileName)
    local Success, Data = pcall(function() return HttpService:JSONDecode(RawData) end)
    
    if Success then
        for flag, value in pairs(Data) do
            if typeof(value) == "table" and value.Type == "Color3" then
                self.Flags[flag] = Color3.new(value.R, value.G, value.B)
            elseif typeof(value) == "table" and value.Type == "Enum" then
                -- Odbudowa Enum z nazwy stringa
                local EnumType = tostring(value.Value):split(".")[1]
                local EnumItem = tostring(value.Value):split(".")[2]
                pcall(function() self.Flags[flag] = Enum[EnumType][EnumItem] end)
            else
                self.Flags[flag] = value
            end
        end
    end
end

