                local Position, OnScreen = Camera:WorldToViewportPoint(RootPart.Position)

                if OnScreen and self.Flags["ESP_Tracers"] then
                    local ScreenSize = Camera.ViewportSize
                    local Origin = self.Flags["Tracer_Origin"] or "Bottom"
                    
                    -- Wybór punktu startowego
                    if Origin == "Bottom" then
                        Line.From = Vector2.new(ScreenSize.X / 2, ScreenSize.Y)
                    elseif Origin == "Center" then
                        Line.From = Vector2.new(ScreenSize.X / 2, ScreenSize.Y / 2)
                    else -- Mouse
                        Line.From = game:GetService("UserInputService"):GetMouseLocation()
                    end

                    Line.To = Vector2.new(Position.X, Position.Y)
                    Line.Visible = true
                    Line.Color = self.Flags["ESP_Color"] or self.Config.Theme.Accent
                else
                    Line.Visible = false
                end
            else
                Line.Visible = false
                if not TargetPlayer.Parent then
                    Line:Remove()
                    Connection:Disconnect()
                end
            end
        end)
    end
    
    coroutine.wrap(Update)()
