function Phantom:CreateWindow(settings)
    settings = settings or {}
    local mobile = isMobile()

    -- FIX 6: re-execute cleanup -- destroy any existing PhantomUI before creating new
    pcall(function()
        for _, gui in ipairs(CoreGui:GetChildren()) do
            if gui.Name == "PhantomUI" or gui.Name == "PhantomKey" then gui:Destroy() end
        end
    end)
    pcall(function()
        if gethui then
            for _, gui in ipairs(gethui():GetChildren()) do
                if gui.Name == "PhantomUI" or gui.Name == "PhantomKey" then gui:Destroy() end
            end
        end
    end)
    pcall(function()
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for _, gui in ipairs(pg:GetChildren()) do
                if gui.Name == "PhantomUI" or gui.Name == "PhantomKey" then gui:Destroy() end
            end
        end
    end)

    if settings.Theme and Phantom.Themes[settings.Theme] then
        Theme = Phantom.Themes[settings.Theme]
    end

    local ScreenGui = new("ScreenGui", {
        Name = "PhantomUI", ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        IgnoreGuiInset = true, DisplayOrder = 100,
    })
    parentGui(ScreenGui)

    -- Key system ----------------------------------------------------------
    if settings.KeySystem and settings.KeySettings then
        local keys = settings.KeySettings.Key
        if type(keys) == "string" then keys = { keys } end
        if type(keys) ~= "table" or #keys == 0 then keys = { "" } end

        local keyFile = CFG_FOLDER .. "/" .. (settings.KeySettings.FileName or "key") .. CFG_EXT
        ensureFolder("Phantom"); ensureFolder(CFG_FOLDER)

        local approved = false
        if settings.KeySettings.SaveKey then
            local saved = safeRead(keyFile)
            if saved then
                for _, k in ipairs(keys) do
                    if saved == k then approved = true; break end
                end
            end
        end

        if not approved then
            local KeyGui = new("ScreenGui", {
                Name = "PhantomKey", IgnoreGuiInset = true,
                ResetOnSpawn = false, DisplayOrder = 200,
            })
            parentGui(KeyGui)

            local box = new("Frame", {
                BackgroundColor3 = Theme.Bg,
                Size = UDim2.new(0, 380, 0, 230),
                Position = UDim2.new(0.5, -190, 0.5, -115),
                BackgroundTransparency = 1, Parent = KeyGui,
            })
            corner(box, 14)
            local boxStroke = stroke(box, Theme.StrokeAccent, 1, 0.4)
            shadow(box, 0.5)
            gradient(box, { Theme.BgGradient1, Theme.BgGradient2 }, 135)
            pad(box, 22)
            glow(box, Theme.AccentGlow, 80, 0.85)
            tween(box, Anim.Bounce, { BackgroundTransparency = 0 })

            new("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 24),
                Font = Enum.Font.GothamBold, TextSize = 18,
                TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left,
                Text = settings.KeySettings.Title or "Phantom", Parent = box,
            })
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 28),
                Size = UDim2.new(1, 0, 0, 18),
                Font = Enum.Font.Gotham, TextSize = 12,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = settings.KeySettings.Subtitle or "Key System", Parent = box,
            })
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 0, 56),
                Size = UDim2.new(1, 0, 0, 50),
                Font = Enum.Font.Gotham, TextSize = 12,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                TextWrapped = true,
                Text = settings.KeySettings.Note or "Enter your key.", Parent = box,
            })

            local statusLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 0, 1, -98),
                Size = UDim2.new(1, 0, 0, 14),
                Font = Enum.Font.Gotham, TextSize = 11,
                TextColor3 = Theme.TextDim,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = "", Parent = box,
            })

            local inputBg = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Position = UDim2.new(0, 0, 1, -82),
                Size = UDim2.new(1, 0, 0, 36),
                Parent = box,
            })
            corner(inputBg, 10)
            local kInputStroke = stroke(inputBg, Theme.Stroke, 1)
            local inputBox = new("TextBox", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -20, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                Font = Enum.Font.Gotham, TextSize = 13,
                TextColor3 = Theme.Text,
                PlaceholderText = "Enter key...",
                PlaceholderColor3 = Theme.TextDark,
                Text = "", ClearTextOnFocus = false,
                Parent = inputBg,
            })
            inputBox.Focused:Connect(function() tween(kInputStroke, Anim.Fast, { Color = Theme.Accent }) end)
            inputBox.FocusLost:Connect(function() tween(kInputStroke, Anim.Fast, { Color = Theme.Stroke }) end)

            local submitBtn = new("TextButton", {
                BackgroundColor3 = Theme.Accent,
                Position = UDim2.new(0, 0, 1, -36),
                Size = UDim2.new(1, 0, 0, 36),
                Font = Enum.Font.GothamBold, TextSize = 13,
                TextColor3 = Theme.TextBright, Text = "Submit",
                AutoButtonColor = false, Parent = box,
            })
            corner(submitBtn, 10)
            gradient(submitBtn, { Theme.AccentBright, Theme.Accent }, 90)
            attachRipple(submitBtn)

            -- FIX 2: bulletproof key check.
            local processing = false
            local function tryKey()
                if processing or approved then return end
                processing = true

                local raw = inputBox.Text or ""
                -- trim leading/trailing whitespace
                local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")

                local match = false
                for _, k in ipairs(keys) do
                    if trimmed == k then match = true; break end
                end

                if match then
                    approved = true
                    if settings.KeySettings.SaveKey then safeWrite(keyFile, trimmed) end
                    statusLabel.Text = "Verified."
                    statusLabel.TextColor3 = Theme.Success
                    tween(box, Anim.Smooth, {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(0, 380, 0, 0),
                        Position = UDim2.new(0.5, -190, 0.5, 0),
                    })
                    task.wait(0.4)
                    KeyGui:Destroy()
                else
                    statusLabel.Text = "Invalid key. Try again."
                    statusLabel.TextColor3 = Theme.Error
                    inputBox.Text = ""
                    tween(boxStroke, Anim.Fast, { Color = Theme.Error })
                    local origPos = box.Position
                    for _ = 1, 3 do
                        tween(box, TweenInfo.new(0.05), { Position = origPos + UDim2.new(0, 8, 0, 0) })
                        task.wait(0.05)
                        tween(box, TweenInfo.new(0.05), { Position = origPos - UDim2.new(0, 8, 0, 0) })
                        task.wait(0.05)
                    end
                    tween(box, Anim.Fast, { Position = origPos })
                    tween(boxStroke, Anim.Fast, { Color = Theme.StrokeAccent })
                    processing = false
                end
            end

            submitBtn.MouseButton1Click:Connect(tryKey)
            submitBtn.TouchTap:Connect(tryKey)
            inputBox.FocusLost:Connect(function(enterPressed)
                if enterPressed then tryKey() end
            end)

            -- block until verified
            while not approved do task.wait() end
        end
    end

