        Window.ActiveTab = Tab
    end

    TabBtn.MouseButton1Click:Connect(function()
        Tab:Activate()
    end)

    Tab.Page = Page
    Tab.Btn = TabBtn
    Tab.Label = TabLabel
    Tab.Bar = ActiveBar
    table.insert(Window.Tabs, Tab)

    -- Auto-select pierwszej zakładki
    if #Window.Tabs == 1 then
        Tab:Activate()
    end

    return Tab
end
