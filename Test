    local Presets = {
        ["Midnight"] = {
            Main = Color3.fromRGB(15, 15, 20),
            Secondary = Color3.fromRGB(20, 20, 25),
            Accent = Color3.fromRGB(80, 120, 255),
            Outline = Color3.fromRGB(40, 40, 50)
        },
        ["Crimson"] = {
            Main = Color3.fromRGB(20, 10, 10),
            Secondary = Color3.fromRGB(30, 15, 15),
            Accent = Color3.fromRGB(255, 60, 60),
            Outline = Color3.fromRGB(60, 30, 30)
        },
        ["Emerald"] = {
            Main = Color3.fromRGB(10, 20, 15),
            Secondary = Color3.fromRGB(15, 30, 20),
            Accent = Color3.fromRGB(60, 255, 120),
            Outline = Color3.fromRGB(30, 60, 40)
        },
        ["Sakura"] = {
            Main = Color3.fromRGB(25, 20, 25),
            Secondary = Color3.fromRGB(35, 25, 35),
            Accent = Color3.fromRGB(255, 150, 200),
            Outline = Color3.fromRGB(60, 45, 60)
        }
    }

    local selected = Presets[presetName]
    if not selected then return end

    -- Aktualizacja tabeli Config
    Config.Theme.Main = selected.Main
    Config.Theme.Secondary = selected.Secondary
    Config.Theme.Accent = selected.Accent
    Config.Theme.Outline = selected.Outline

    -- Silnik masowej aktualizacji wizualnej
    for _, obj in pairs(self.ScreenGui:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ScrollingFrame") then
            if obj.BackgroundColor3 == Config.Theme.Main then
                Utils:Tween(obj, {BackgroundColor3 = selected.Main}, 0.5)
            elseif obj.BackgroundColor3 == Config.Theme.Secondary then
                Utils:Tween(obj, {BackgroundColor3 = selected.Secondary}, 0.5)
            end
        elseif obj:IsA("TextLabel") or obj:IsA("TextBox") then
            if obj.TextColor3 == Config.Theme.Accent then
                Utils:Tween(obj, {TextColor3 = selected.Accent}, 0.5)
            end
        elseif obj:IsA("UIStroke") then
            if obj.Color == Config.Theme.Outline then
                Utils:Tween(obj, {Color = selected.Outline}, 0.5)
            elseif obj.Color == Config.Theme.Accent then
                Utils:Tween(obj, {Color = selected.Accent}, 0.5)
            end
        end
    end
    
    -- Aktualizacja kursora i powiadomień
    if self.ScreenGui:FindFirstChild("CustomCursor") then
        self.ScreenGui.CustomCursor.ImageColor3 = selected.Accent
    end
    
    self:Log("Theme switched to: " .. presetName, "Info")
    self:SaveConfig()
end
