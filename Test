-- [45] SPINBOT ENGINE (System Anti-Aim)
--========================================================================

function Phantom:InitSpinbot()
    local RunService = game:GetService("RunService")
    local LP = game.Players.LocalPlayer
    
    RunService.RenderStepped:Connect(function()
        if self.Flags["Spinbot_Enabled"] and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
            local Root = LP.Character.HumanoidRootPart
            local Speed = self.Flags["Spinbot_Speed"] or 50
            
            -- Rotacja bez wpływu na fizykę ruchu
            Root.CFrame = Root.CFrame * CFrame.Angles(0, math.rad(Speed), 0)
        end
    end)
end
