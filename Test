local function buildLogo(parent, size, useImage)
    local holder = new("Frame", {
        BackgroundColor3 = Theme.Accent,
        Size = UDim2.new(0, size, 0, size),
        Parent = parent,
    })
    corner(holder, math.floor(size * 0.3))

    if useImage and Phantom.Config.LogoImage then
        holder.BackgroundTransparency = 1
        new("ImageLabel", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Image = Phantom.Config.LogoImage,
            ScaleType = Enum.ScaleType.Fit,
            Parent = holder,
        })
    else
        gradient(holder, { Theme.AccentBright, Theme.Accent, Theme.AccentDim }, 135)
        glow(holder, Theme.AccentGlow, math.floor(size * 0.6), 0.55)
        new("TextLabel", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
            Font = Enum.Font.GothamBlack, TextSize = math.floor(size * 0.55),
            TextColor3 = Theme.TextBright,
            Text = Phantom.Config.LogoText or "P",
            Parent = holder,
        })
    end
    return holder
end

