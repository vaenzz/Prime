    local SldStroke = Instance.new("UIStroke")
    SldStroke.Color = Config.Theme.Outline
    SldStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    SldStroke.Transparency = 0.2
    SldStroke.Parent = SliderFrame

    local Title = Instance.new("TextLabel")
    Title.Parent = SliderFrame
    Title.Position = UDim2.new(0, 15, 0, 10)
    Title.Size = UDim2.new(1, -120, 0, 14)
    Title.Text = Name
    Title.Font = Enum.Font.GothamBold
    Title.TextColor3 = Config.Theme.Text
    Title.TextSize = 13
    Title.TextXAlignment = Enum.TextXAlignment.Left
    Title.BackgroundTransparency = 1

    -- Interaktywny Box Wartości (Style: Fluent/MacLib)
    local ValueContainer = Instance.new("Frame")
    ValueContainer.Parent = SliderFrame
    ValueContainer.Position = UDim2.new(1, -75, 0, 8)
    ValueContainer.Size = UDim2.new(0, 60, 0, 20)
    ValueContainer.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    ValueContainer.BorderSizePixel = 0
    
    local ValCorner = Instance.new("UICorner")
    ValCorner.CornerRadius = UDim.new(0, 4)
    ValCorner.Parent = ValueContainer

    local ValueInput = Instance.new("TextBox")
    ValueInput.Parent = ValueContainer
    ValueInput.Size = UDim2.new(1, 0, 1, 0)
    ValueInput.BackgroundTransparency = 1
    ValueInput.Text = tostring(Default) .. Postfix
    ValueInput.TextColor3 = Config.Theme.Accent
    ValueInput.Font = Enum.Font.GothamMedium
    ValueInput.TextSize = 12
    ValueInput.ClearTextOnFocus = false

    local SliderRail = Instance.new("Frame")
    SliderRail.Parent = SliderFrame
    SliderRail.Position = UDim2.new(0, 15, 0, 38)
    SliderRail.Size = UDim2.new(1, -30, 0, 4)
    SliderRail.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    SliderRail.BorderSizePixel = 0
    
    local SliderFill = Instance.new("Frame")
    SliderFill.Parent = SliderRail
    SliderFill.Size = UDim2.new((Default - Min) / (Max - Min), 0, 1, 0)
    SliderFill.BackgroundColor3 = Config.Theme.Accent
    SliderFill.BorderSizePixel = 0
    
    local FillCorner = Instance.new("UICorner")
    FillCorner.CornerRadius = UDim.new(1, 0)
    FillCorner.Parent = SliderFill

    local function UpdateValue(val, ignoreInput)
        -- Logika Kroków (Steps)
        val = math.clamp(val, Min, Max)
        val = math.floor(val / Step + 0.5) * Step
        
        local rawPos = (val - Min) / (Max - Min)
        Utils:Tween(SliderFill, {Size = UDim2.new(rawPos, 0, 1, 0)}, 0.1)
        
        if not ignoreInput then
            ValueInput.Text = tostring(val) .. Postfix
        end
        
        self.Flags[Flag] = val
        task.spawn(callback, val)
    end

    -- Obsługa myszki/dotyku
    local dragging = false
    SliderFrame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = true
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local pos = math.clamp((input.Position.X - SliderRail.AbsolutePosition.X) / SliderRail.AbsoluteSize.X, 0, 1)
            local val = Min + (Max - Min) * pos
            UpdateValue(val)
        end
    end)

    -- Obsługa wpisywania ręcznego
    ValueInput.FocusLost:Connect(function()
        local cleanText = ValueInput.Text:gsub(Postfix, "")
        local num = tonumber(cleanText)
        if num then
            UpdateValue(num)
        else
            ValueInput.Text = tostring(self.Flags[Flag]) .. Postfix
        end
    end)

    -- Animacja pojawienia się
    Utils:Tween(SliderFrame, {GroupTransparency = 0}, 0.3)

    return SliderFrame
end
