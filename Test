-- [38] AIMBOT LOGIC (Smoothing & Target Acquisition)
--========================================================================

local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Camera = workspace.CurrentCamera
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

function Phantom:GetClosestPlayer()
    local Closest = nil
    local MaxDist = self.Flags["Aimbot_FOV_Radius"] or 100
    local MousePos = UserInputService:GetMouseLocation()

    for _, v in pairs(Players:GetPlayers()) do
        if v ~= LocalPlayer and v.Character and v.Character:FindFirstChild("Humanoid") and v.Character.Humanoid.Health > 0 then
            -- Wybór części ciała (domyślnie Head)
            local TargetPart = v.Character:FindFirstChild(self.Flags["Aimbot_TargetPart"] or "Head")
            if TargetPart then
                local ScreenPos, OnScreen = Camera:WorldToViewportPoint(TargetPart.Position)
                if OnScreen then
                    local Distance = (Vector2.new(ScreenPos.X, ScreenPos.Y) - MousePos).Magnitude
                    if Distance < MaxDist then
                        MaxDist = Distance
                        Closest = v
                    end
                end
            end
        end
    end
    return Closest
end

RunService.RenderStepped:Connect(function()
    if self.Flags["Aimbot_Enabled"] and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
        local Target = Phantom:GetClosestPlayer()
        if Target and Target.Character then
            local TargetPart = Target.Character[self.Flags["Aimbot_TargetPart"] or "Head"]
            local Smoothness = self.Flags["Aimbot_Smoothing"] or 1 -- 1 = brak smoothingu
            
            -- Magia Smoothingu
            local LookAt = CFrame.new(Camera.CFrame.Position, TargetPart.Position)
            Camera.CFrame = Camera.CFrame:Lerp(LookAt, 1 / Smoothness)
        end
    end
end)
