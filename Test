        function Tab:CreateDropdown(cfg)
            local container = ensureSection()
            maybeAddDivider(container)

            local obj = {
                Type = "Dropdown",
                CurrentOption = cfg.CurrentOption or {},
                Callback = cfg.Callback,
            }
            if type(obj.CurrentOption) == "string" then obj.CurrentOption = { obj.CurrentOption } end

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ClipsDescendants = true, Parent = container,
            })
            corner(Frame, 10)
            local frameStroke = stroke(Frame, Theme.Stroke, 1)
            new("UIListLayout", { Parent = Frame })

            local Header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), Parent = Frame })
            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(0.5, -14, 1, 0),
                Font = Enum.Font.GothamMedium, TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = cfg.Name, Parent = Header,
            })
            local SelectedLabel = new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0.5, 0, 0, 0),
                Size = UDim2.new(0.5, -36, 1, 0),
                Font = Enum.Font.Gotham, TextSize = 12,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Right,
                Text = "None", Parent = Header,
            })

            -- Drawn arrow
            local arrowHolder = new("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, -22, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 12, 0, 12), Parent = Header,
            })
            local aL = new("Frame", {
                BackgroundColor3 = Theme.TextDim, BorderSizePixel = 0,
                Size = UDim2.new(0, 7, 0, 1.5),
                Position = UDim2.new(0.5, -2, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Rotation = 45, Parent = arrowHolder,
            })
            corner(aL, 1)
            local aR = new("Frame", {
                BackgroundColor3 = Theme.TextDim, BorderSizePixel = 0,
                Size = UDim2.new(0, 7, 0, 1.5),
                Position = UDim2.new(0.5, 2, 0.5, 0),
                AnchorPoint = Vector2.new(0.5, 0.5),
                Rotation = -45, Parent = arrowHolder,
            })
            corner(aR, 1)

            local Click = new("TextButton", {
                BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                Text = "", AutoButtonColor = false, Parent = Header,
            })

            local List = new("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Visible = false, Parent = Frame,
            })
            new("UIListLayout", { Padding = UDim.new(0, 4), Parent = List })
            pad(List, 0, 10, 12, 12)

            local optionFrames = {}
            local function updateLabel()
                if #obj.CurrentOption == 0 then SelectedLabel.Text = "None"
                elseif #obj.CurrentOption == 1 then SelectedLabel.Text = obj.CurrentOption[1]
                else SelectedLabel.Text = "Various (" .. #obj.CurrentOption .. ")" end
            end

            local function updateStyles()
                for opt, of in pairs(optionFrames) do
                    if table.find(obj.CurrentOption, opt) then
                        tween(of.frame, Anim.Fast, { BackgroundColor3 = Theme.Accent })
                        tween(of.label, Anim.Fast, { TextColor3 = Theme.TextBright })
                        tween(of.stroke, Anim.Fast, { Color = Theme.AccentBright })
                    else
                        tween(of.frame, Anim.Fast, { BackgroundColor3 = Theme.Bg })
                        tween(of.label, Anim.Fast, { TextColor3 = Theme.TextDim })
                        tween(of.stroke, Anim.Fast, { Color = Theme.Stroke })
                    end
                end
            end

            local open = false
            local function setOpen(s)
                open = s
                List.Visible = s
                tween(arrowHolder, Anim.Smooth, { Rotation = s and 180 or 0 })
            end
            Click.MouseButton1Click:Connect(function() setOpen(not open) end)

            local function buildOptions()
                for _, c in ipairs(List:GetChildren()) do
                    if c:IsA("Frame") then c:Destroy() end
                end
                optionFrames = {}
                for _, opt in ipairs(cfg.Options or {}) do
                    local optFrame = new("Frame", {
                        BackgroundColor3 = Theme.Bg,
                        Size = UDim2.new(1, 0, 0, 30), Parent = List,
                    })
                    corner(optFrame, 8)
                    local optStroke = stroke(optFrame, Theme.Stroke, 1)
                    local optLabel = new("TextLabel", {
                        BackgroundTransparency = 1,
                        Position = UDim2.new(0, 12, 0, 0),
                        Size = UDim2.new(1, -24, 1, 0),
                        Font = Enum.Font.Gotham, TextSize = 12,
                        TextColor3 = Theme.TextDim,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Text = opt, Parent = optFrame,
                    })
                    local optClick = new("TextButton", {
                        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
                        Text = "", AutoButtonColor = false, Parent = optFrame,
                    })
                    attachRipple(optClick)
                    optionFrames[opt] = { frame = optFrame, label = optLabel, stroke = optStroke }

                    optClick.MouseButton1Click:Connect(function()
                        if cfg.MultipleOptions then
                            local idx = table.find(obj.CurrentOption, opt)
                            if idx then table.remove(obj.CurrentOption, idx)
                            else table.insert(obj.CurrentOption, opt) end
                        else
                            obj.CurrentOption = { opt }
                            setOpen(false)
                        end
                        updateLabel(); updateStyles()
                        pcall(cfg.Callback, obj.CurrentOption)
                        saveConfig()
                    end)
                end
                updateStyles()
            end
            buildOptions(); updateLabel()

            Frame.MouseEnter:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.StrokeAccent }) end)
            Frame.MouseLeave:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.Stroke }) end)

            attachTooltip(Frame, cfg.Tooltip)

            function obj:Set(opts)
                if type(opts) == "string" then opts = { opts } end
                obj.CurrentOption = opts or {}
                updateLabel(); updateStyles()
                pcall(cfg.Callback, obj.CurrentOption)
                saveConfig()
            end
            function obj:Refresh(newOpts)
                cfg.Options = newOpts; buildOptions(); updateLabel()
            end

            if cfg.Flag then Phantom.Flags[cfg.Flag] = obj end
            fadeInElement(Frame)
            table.insert(allElements, { frame = Frame, name = cfg.Name })
            return obj
        end

        ----------------------------------------------------------------
        -- Input
        ----------------------------------------------------------------
        function Tab:CreateInput(cfg)
            local container = ensureSection()
            maybeAddDivider(container)

            local obj = {
                Type = "Input", CurrentValue = cfg.CurrentValue or "",
                Callback = cfg.Callback,
            }

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 38), Parent = container,
            })
            corner(Frame, 10)
            local frameStroke = stroke(Frame, Theme.Stroke, 1)

            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(0.4, -14, 1, 0),
                Font = Enum.Font.GothamMedium, TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = cfg.Name, Parent = Frame,
            })

            local InputBg = new("Frame", {
                BackgroundColor3 = Theme.Bg,
                Position = UDim2.new(1, -176, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 162, 0, 26), Parent = Frame,
            })
            corner(InputBg, 8)
            local inputStroke = stroke(InputBg, Theme.Stroke, 1)

            local InputBox = new("TextBox", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -16, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                Font = Enum.Font.Gotham, TextSize = 12,
                TextColor3 = Theme.Text,
                Text = obj.CurrentValue,
                PlaceholderText = cfg.PlaceholderText or "",
                PlaceholderColor3 = Theme.TextDark,
                ClearTextOnFocus = false,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = InputBg,
            })
            InputBox.Focused:Connect(function() tween(inputStroke, Anim.Fast, { Color = Theme.Accent }) end)
            InputBox.FocusLost:Connect(function()
                tween(inputStroke, Anim.Fast, { Color = Theme.Stroke })
                obj.CurrentValue = InputBox.Text
                pcall(cfg.Callback, InputBox.Text)
                if cfg.RemoveTextAfterFocusLost then InputBox.Text = "" end
                saveConfig()
            end)

            Frame.MouseEnter:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.StrokeAccent }) end)
            Frame.MouseLeave:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.Stroke }) end)

            attachTooltip(Frame, cfg.Tooltip)

            function obj:Set(v)
                InputBox.Text = tostring(v); obj.CurrentValue = tostring(v)
                pcall(cfg.Callback, tostring(v)); saveConfig()
            end

            if cfg.Flag then Phantom.Flags[cfg.Flag] = obj end
            fadeInElement(Frame)
            table.insert(allElements, { frame = Frame, name = cfg.Name })
            return obj
        end

        ----------------------------------------------------------------
        -- Keybind
        ----------------------------------------------------------------
        function Tab:CreateKeybind(cfg)
            local container = ensureSection()
            maybeAddDivider(container)

            local obj = {
                Type = "Keybind",
                CurrentKeybind = cfg.CurrentKeybind or "Q",
                Callback = cfg.Callback,
            }

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element,
                Size = UDim2.new(1, 0, 0, 38), Parent = container,
            })
            corner(Frame, 10)
            local frameStroke = stroke(Frame, Theme.Stroke, 1)

            new("TextLabel", {
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(1, -100, 1, 0),
                Font = Enum.Font.GothamMedium, TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
                Text = cfg.Name, Parent = Frame,
            })

            local KeyBox = new("TextButton", {
                BackgroundColor3 = Theme.Bg,
                Position = UDim2.new(1, -82, 0.5, 0),
                AnchorPoint = Vector2.new(0, 0.5),
                Size = UDim2.new(0, 68, 0, 26),
                Font = Enum.Font.GothamBold, TextSize = 12,
                TextColor3 = Theme.Accent, Text = obj.CurrentKeybind,
                AutoButtonColor = false, Parent = Frame,
            })
            corner(KeyBox, 8)
            local keyStroke = stroke(KeyBox, Theme.Stroke, 1)

            local listening = false
            KeyBox.MouseButton1Click:Connect(function()
                listening = true; KeyBox.Text = "..."
                tween(keyStroke, Anim.Fast, { Color = Theme.Accent })
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if listening and input.KeyCode ~= Enum.KeyCode.Unknown then
                    listening = false
                    obj.CurrentKeybind = input.KeyCode.Name
                    KeyBox.Text = obj.CurrentKeybind
                    tween(keyStroke, Anim.Fast, { Color = Theme.Stroke })
                    if cfg.CallOnChange then pcall(cfg.Callback, obj.CurrentKeybind) end
                    saveConfig()
                elseif not processed and not listening
                    and input.KeyCode == Enum.KeyCode[obj.CurrentKeybind] then
                    if not cfg.CallOnChange then pcall(cfg.Callback) end
                end
            end)

            Frame.MouseEnter:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.StrokeAccent }) end)
            Frame.MouseLeave:Connect(function() tween(frameStroke, Anim.Fast, { Color = Theme.Stroke }) end)

            attachTooltip(Frame, cfg.Tooltip)

            function obj:Set(k)
                obj.CurrentKeybind = tostring(k)
                KeyBox.Text = obj.CurrentKeybind; saveConfig()
            end

            if cfg.Flag then Phantom.Flags[cfg.Flag] = obj end
            fadeInElement(Frame)
            table.insert(allElements, { frame = Frame, name = cfg.Name })
            return obj
        end

        ----------------------------------------------------------------
        -- Label
        ----------------------------------------------------------------
        function Tab:CreateLabel(text)
            local container = ensureSection()
            maybeAddDivider(container)

            local Frame = new("Frame", {
                BackgroundColor3 = Theme.Element, BackgroundTransparency = 0.3,
                Size = UDim2.new(1, 0, 0, 30), Parent = container,
            })
