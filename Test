    local s = stroke(notif, Theme.Stroke, 1, 1)
    shadow(notif, 0.5)
    gradient(notif, { Theme.PanelGradient1, Theme.PanelGradient2 }, 135)
    pad(notif, 12, 12, 14, 14)

    -- Icon circle (left)
