-- ====================== POMOCNICZA FUNKCJA: SZYFROWANIE ======================
local function encrypt(data)
    if Phantom.Config.Encrypt and hasCrypt then
        local success, encrypted = pcall(syn.crypt.encrypt, data, "PhantomKey")
        if success then return encrypted end
    end
    return data  -- brak szyfrowania lub błąd
end

local function decrypt(data)
    if Phantom.Config.Encrypt and hasCrypt then
        local success, decrypted = pcall(syn.crypt.decrypt, data, "PhantomKey")
        if success then return decrypted end
    end
    return data  -- brak szyfrowania lub dane niezaszyfrowane
end

-- ====================== ZAPISYWANIE KONFIGURACJI ======================
function Phantom.Config.SaveConfig(name, data)
    if not hasWriteFile then
        warn("[Phantom] Nie można zapisać – brak writefile.")
        return false
    end

    local success, json
    if pcall(function() return game:GetService("HttpService"):JSONEncode(data) end) then
        json = game:GetService("HttpService"):JSONEncode(data)
    else
        -- Fallback: ręczna serializacja (ograniczona, ale działa dla prostych tabel)
        json = "return " .. tostring(data)
    end

    local filePath = Phantom.Config.FolderName .. "/" .. name .. ".json"
    local content = encrypt(json)

    local writeSuccess, err = pcall(function()
        writefile(filePath, content)
    end)

    if not writeSuccess then
        warn("[Phantom] Błąd zapisu config '" .. name .. "': " .. tostring(err))
        return false
    end
    return true
end

-- ====================== WCZYTYWANIE KONFIGURACJI ======================
function Phantom.Config.LoadConfig(name)
    if not hasReadFile then
        warn("[Phantom] Nie można wczytać – brak readfile.")
        return nil
    end

    local filePath = Phantom.Config.FolderName .. "/" .. name .. ".json"
    local isFile = pcall(isfile, filePath)
    if not isFile then return nil end

    local success, content = pcall(readfile, filePath)
    if not success then
        warn("[Phantom] Nie udało się odczytać pliku: " .. filePath)
        return nil
    end

    local decrypted = decrypt(content)

    -- Parsowanie JSON
    local data
    if pcall(function() return game:GetService("HttpService"):JSONDecode(decrypted) end) then
        data = game:GetService("HttpService"):JSONDecode(decrypted)
    else
        -- Fallback: ręczne parsowanie (jeśli wcześniej użyto tostring)
        local func, err = loadstring(decrypted)
        if func then
            data = func()
        else
            warn("[Phantom] Nieprawidłowy format config '" .. name .. "'.")
            return nil
        end
    end
    return data
end

-- ====================== LISTOWANIE WSZYSTKICH KONFIGÓW ======================
function Phantom.Config.GetConfigs()
    local configs = {}
    if not hasIsFile then return configs end

    local folderPath = Phantom.Config.FolderName
    -- Próbujemy listować pliki (executory często nie mają tej funkcji, więc opcjonalnie)
    local listFiles = pcall(function()
        local files = listfiles(folderPath)
        if files then
            for _, file in ipairs(files) do
                if file:sub(-5) == ".json" then
                    local name = file:match("([^/]+)%.json$")
                    if name then
                        table.insert(configs, name)
                    end
                end
            end
        end
    end)
    return configs
end

-- ====================== ZARZĄDZANIE ŚCIEŻKAMI USTAWIEŃ ======================
-- Stored data dla bieżącej sesji (jako podstawa do OverrideSetting)
Phantom.Config.StoredData = {}

function Phantom.Config.SetStoredData(data)
    Phantom.Config.StoredData = data or {}
end

function Phantom.Config.OverrideSetting(path, value)
    -- path np. "Main.Toggle1" lub "MyWindow.Slider"
    local keys = {}
    for part in path:gmatch("[^%.]+") do
        table.insert(keys, part)
    end

    local current = Phantom.Config.StoredData
    for i = 1, #keys - 1 do
        local k = keys[i]
        if type(current[k]) ~= "table" then
            current[k] = {}
        end
        current = current[k]
    end
    current[keys[#keys]] = value
end

function Phantom.Config.GetSetting(path)
    local keys = {}
    for part in path:gmatch("[^%.]+") do
        table.insert(keys, part)
    end

    local current = Phantom.Config.StoredData
    for _, k in ipairs(keys) do
        if type(current) == "table" and current[k] ~= nil then
            current = current[k]
        else
            return nil
        end
    end
    return current
end

