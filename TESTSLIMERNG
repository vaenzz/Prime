-- ====================== BEZPIECZNE POBIERANIE OBRAZU ======================
function Phantom.LoadImage(url: string): string?
    -- Sprawdź czy już mamy ten obraz (kluczem jest url)
    if Phantom.ImageCache[url] then
        return url
    end

    local success, imageData = pcall(function()
        return game:HttpGet(url)
    end)

    if not success or not imageData then
        if Phantom.SecureMode then
            warn("[Phantom] Nie udało się pobrać obrazu: " .. url)
        end
        return nil
    end

    -- Tworzymy tymczasowy obiekt Image, żeby uzyskać decal ID
    local tempImage = Instance.new("ImageLabel")
    tempImage.Visible = false
    tempImage.Parent = game:GetService("CoreGui") or game:GetService("StarterGui")

    local setSuccess = pcall(function()
        tempImage.Image = imageData   -- dla większości executorów to powinno zadziałać
    end)

    if not setSuccess then
        tempImage:Destroy()
        warn("[Phantom] Executor nie obsługuje bezpośredniego przypisania Image z danych.")
        return nil
    end

    -- Czekamy aż image się załaduje (max 2 sekundy)
    local start = tick()
    repeat wait(0.1) until tempImage.IsLoaded or tick() - start > 2

    if not tempImage.IsLoaded then
        tempImage:Destroy()
        if Phantom.SecureMode then
            warn("[Phantom] Obraz nie załadował się: " .. url)
        end
        return nil
    end

    -- Pobieramy identyfikator decala (rządzi "rbxassetid://...")
    local assetId = tempImage.Image
    tempImage:Destroy()

    -- Cache'ujemy
    Phantom.ImageCache[url] = assetId
    return assetId
end

-- ====================== POBIERANIE Z CACHE'U ======================
function Phantom.GetImage(urlOrId: string): string?
    if Phantom.ImageCache[urlOrId] then
        return Phantom.ImageCache[urlOrId]
    end
    -- Jeśli to już jakiś asset ID (rbxassetid://), zwróć
    if urlOrId:sub(1,13) == "rbxassetid://" then
        return urlOrId
    end
    return nil
end

