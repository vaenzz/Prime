-- Używamy cloneref dla bezpieczeństwa (ukrycie przed antycheatami)
local Services = {}
local function getService(serviceName)
    if Services[serviceName] then
        return Services[serviceName]
    end

    local success, service = pcall(function()
        return game:GetService(serviceName)
    end)
    if not success then return nil end

    -- Dodatkowe zabezpieczenie: cloneref jeśli dostępny (większość executorów)
    local protectedService = service
    if cloneref and type(cloneref) == "function" then
        local cloneSuccess, cloned = pcall(cloneref, service)
        if cloneSuccess then
            protectedService = cloned
        end
    elseif hookfunction and type(hookfunction) == "function" then
        -- Alternatywa dla executorów bez cloneref (np. stare Krnl)
        protectedService = service
    end

    Services[serviceName] = protectedService
    return protectedService
end
Phantom.GetService = getService

-- ====================== BEZPIECZNE WYKONYWANIE (CALLBACK SAFETY) ======================
function Phantom.CallSafely(callback, ...)
    local args = {...}
    local success, result = pcall(callback, unpack(args))
    if not success then
        if Phantom.SecureMode then
            warn("[Phantom] Blokada błędu (secure mode): " .. tostring(result))
        else
            error("[Phantom] Błąd callbacku: " .. tostring(result), 2)
        end
    end
    return success, result
end

-- ====================== BEZPIECZNE POWIADOMIENIA ======================
function Phantom.SecureNotify(title, text, duration)
    local StarterGui = getService("StarterGui")
    if not StarterGui then return end

    local success, result = pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title or "Phantom",
            Text = text or "",
            Duration = duration or 5,
            Button1 = "OK"
        })
    end)
    if not success then
        -- Fallback: zwykłe CoreGui (dla niektórych executorów)
        pcall(function()
            game:GetService("CoreGui"):SetCore("SendNotification", {
                Title = title or "Phantom",
                Text = text or "",
                Duration = duration or 5
            })
        end)
    end
end

-- ====================== ŁADOWANIE ASSETÓW Z TIMEOUTEM ======================
function Phantom.LoadWithTimeout(url, timeout)
    timeout = timeout or 10
    local start = tick()
    local asset

    repeat
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        if success then
            asset = result
            break
        end
        wait(0.1)
    until tick() - start > timeout

    return asset
end

